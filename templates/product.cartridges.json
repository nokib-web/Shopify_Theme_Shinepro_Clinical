    "collapsible_content_PAb47V": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_i7ihww": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Why use microneedling cartridges?",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>Microneedling cartridges create controlled micro-injuries that stimulate your skin's natural healing response, boosting collagen and elastin production. This process helps reduce the appearance of fine lines, wrinkles, acne scars, and uneven skin texture. The result is firmer, smoother, and more radiant-looking skin with improved overall complexion quality.</p>",
            "page": ""
          }
        },
        "collapsible_row_TqDjCw": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Benefits",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>Enhanced Microneedling Performance<br/><br/>Our 16-needle cartridges deliver superior results with optimized needle depth and spacing. Each pack contains 10 sterile, medical-grade cartridges engineered for consistent puncture patterns that maximize collagen induction and product absorption. The A6S design ensures smooth gliding action and reduced skin trauma, making treatments more comfortable while achieving professional-grade outcomes.</p>",
            "page": ""
          }
        },
        "collapsible_row_XVUgmh": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Specifications",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>Needle Count: 16 needles per cartridge<br/>Cartridge Quantity: 10-pack<br/>Needle Length: 0.25mm<br/>Needle Gauge: 33G<br/>Material: Medical-grade stainless steel<br/>Compatibility: Dr. Pen A6S device<br/>Sterilization: Pre-sterilized and individually sealed<br/>Storage: Keep in cool, dry place before use</p>",
            "page": ""
          }
        },
        "collapsible_row_4cLpDD": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How to use",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>Cleanse the treatment area with a gentle cleanser and pat dry. Apply a thin layer of numbing cream if desired and wait 10-15 minutes. Attach the cartridge firmly to your Dr. Pen device, select your desired speed setting, and begin with gentle, vertical motions across the skin. Use light pressure and avoid sensitive areas. After treatment, apply a soothing serum or moisturizer and use SPF 30+ sunscreen daily for the next week.</p>",
            "page": ""
          }
        },
        "collapsible_row_XpR9ph": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Precautions",
            "icon": "check_box",
            "filled_icon": false,
            "row_content": "<p>Do not use if you are pregnant or nursing. Avoid use on active acne, open wounds, or severely irritated skin. Discontinue use if redness, swelling, or irritation occurs. Not suitable for individuals with bleeding disorders or those taking blood thinners without medical clearance. Consult a healthcare provider before use if you have sensitive skin or are prone to keloid formation. Keep out of reach of children. Store in a cool, dry place away from direct sunlight.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "collapsible_row_i7ihww",
        "collapsible_row_TqDjCw",
        "collapsible_row_XVUgmh",
        "collapsible_row_4cLpDD",
