        "de158e68-5d0d-4819-a625-e2dabdff87d1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Know more about cartridges",
            "heading_size": "medium",
            "icon": "check_box",
            "filled_icon": false,
            "collapse_icon": "carret",
            "display_top_border": true,
            "open": false,
            "content": "<p>Know More About Cartridges<br/><br/>Our cartridges are engineered for precision and compatibility with Dr. Pen devices. Each pack contains sterile, individually packaged needles designed to deliver consistent results. Available in various needle configurations to suit different skin concerns and treatment depths. Store in a cool, dry place and inspect packaging before use. Replace cartridges regularly to maintain optimal performance and hygiene standards.</p>",
            "page": "",
            "margin_top": 24,
            "margin_bottom": 0
          }
        }
