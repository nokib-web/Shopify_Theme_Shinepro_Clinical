            "author_1": "Sarah K [stars]",
            "image_1": "shopify://shop_images/download_16.jpg",
            "text_1": "<p><br/>“The cartridges arrived sealed and high quality. I’ve been using the Dr. Pen device consistently and noticed visible improvement in acne scars and fine lines.”<br/><br/></p>",
            "author_2": "Nicole T [stars]",
            "image_2": "shopify://shop_images/download_18.jpg",
            "text_2": "<p><br/>“Great quality products and authentic packaging. I’ve been using the nano cartridges weekly and my skincare products absorb so much better now.”<br/><br/></p>",
            "author_3": "Amanda R[stars]",
            "image_3": "shopify://shop_images/download_19.jpg",
            "text_3": "<p><br/>“I was honestly nervous to try microneedling at home, but the device is very user-friendly. My skin feels firmer and looks more refreshed already.”<br/><br/></p>",
            "margin_top": 24,
            "margin_bottom": 24
          }
