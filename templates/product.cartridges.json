        "custom_liquid_QxwHjM": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% assign needle_variants = product.metafields.custom.needle.value %}\n{% if needle_variants and needle_variants.size > 0 %}\n  <style>\n    .needle-selector { margin: 16px 0 20px; }\n    .needle-label { font-size: 14px; margin-bottom: 10px; color: #333; }\n    .needle-buttons { display: flex; flex-wrap: wrap; gap: 8px; }\n    .needle-btn {\n      padding: 8px 18px;\n      border: 1px solid #ccc;\n      border-radius: 4px;\n      text-decoration: none;\n      color: #333;\n      font-size: 14px;\n    }\n    .needle-btn:hover { border-color: #333; }\n    .needle-btn.active {\n      background: #002b56;\n      color: #fff;\n      border-color: #1a1a1a;\n    }\n  </style>\n  <div class=\"needle-selector\">\n    {% assign current_label = product.title | split: 'Cartridges ' | last | split: ' - ' | first | remove: ' Pin Type' %}\n    <p class=\"needle-label\">Needles: <strong>{{ current_label }}</strong></p>\n    <div class=\"needle-buttons\">\n      {% for p in needle_variants %}\n        {% assign pin_label = p.title | split: 'Cartridges ' | last | split: ' - ' | first | remove: ' Pin Type' %}\n        <a href=\"{{ p.url }}\" class=\"needle-btn {% if p.id == product.id %}active{% endif %}\">\n          {{ pin_label }}\n        </a>\n      {% endfor %}\n    </div>\n  </div>\n{% endif %}"
          }
        },
