{% doc %}
  @prompt
    create a image banner for this page. Should have all the shema customization option.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
    overflow: hidden;
  }

  .ai-image-banner-container-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    height: {{ block.settings.desktop_height }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner-container-{{ ai_gen_id }} {
      width: 100%;
      height: {{ block.settings.mobile_height }}px;
    }
  }

  .ai-image-banner-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-image-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ block.settings.image_fit }};
    object-position: {{ block.settings.desktop_focal_point }};
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner-image-{{ ai_gen_id }} {
      object-position: {{ block.settings.mobile_focal_point }};
    }
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
    opacity: 0.3;
  }

  .ai-image-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-image-banner-content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    justify-content: {{ block.settings.horizontal_alignment }};
    padding: {{ block.settings.content_padding }}px;
    z-index: 2;
  }

  .ai-image-banner-text-box-{{ ai_gen_id }} {
    max-width: {{ block.settings.text_box_max_width }}px;
    text-align: {{ block.settings.text_alignment }};
    background-color: {{ block.settings.text_box_bg_color }};
    padding: {{ block.settings.text_box_padding }}px;
    border-radius: {{ block.settings.text_box_border_radius }}px;
  }

  .ai-image-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }
  }

  .ai-image-banner-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 {{ block.settings.subheading_spacing }}px 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }
  }

  .ai-image-banner-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0 0 {{ block.settings.description_spacing }}px 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-image-banner-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }

  .ai-image-banner-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_spacing }}px;
    flex-wrap: wrap;
    justify-content: {{ block.settings.text_alignment }};
  }

  .ai-image-banner-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid;
  }

  .ai-image-banner-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_color }};
    border-color: {{ block.settings.button_primary_border }};
  }

  .ai-image-banner-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_bg_hover }};
    color: {{ block.settings.button_primary_color_hover }};
    border-color: {{ block.settings.button_primary_border_hover }};
  }

  .ai-image-banner-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_color }};
    border-color: {{ block.settings.button_secondary_border }};
  }

  .ai-image-banner-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_bg_hover }};
    color: {{ block.settings.button_secondary_color_hover }};
    border-color: {{ block.settings.button_secondary_border_hover }};
  }
{% endstyle %}

<div class="ai-image-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-banner-container-{{ ai_gen_id }}">
    <div class="ai-image-banner-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-image-banner-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-banner-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-image-banner-empty-state-{{ ai_gen_id }}">
            Add an image to get started
          </div>
        </div>
      {% endif %}

      {% if block.settings.enable_overlay %}
        <div class="ai-image-banner-overlay-{{ ai_gen_id }}"></div>
      {% endif %}
    </div>

    {% if block.settings.heading != blank or block.settings.subheading != blank or block.settings.description != blank or block.settings.button_primary_label != blank or block.settings.button_secondary_label != blank %}
      <div class="ai-image-banner-content-{{ ai_gen_id }}">
        <div class="ai-image-banner-text-box-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-image-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
          {% endif %}

          {% if block.settings.subheading != blank %}
            <div class="ai-image-banner-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="ai-image-banner-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
          {% endif %}

          {% if block.settings.button_primary_label != blank or block.settings.button_secondary_label != blank %}
            <div class="ai-image-banner-buttons-{{ ai_gen_id }}">
              {% if block.settings.button_primary_label != blank %}
                <a
                  href="{{ block.settings.button_primary_link }}"
                  class="ai-image-banner-button-{{ ai_gen_id }} ai-image-banner-button-primary-{{ ai_gen_id }}"
                >
                  {{ block.settings.button_primary_label }}
                </a>
              {% endif %}

              {% if block.settings.button_secondary_label != blank %}
                <a
                  href="{{ block.settings.button_secondary_link }}"
                  class="ai-image-banner-button-{{ ai_gen_id }} ai-image-banner-button-secondary-{{ ai_gen_id }}"
                >
                  {{ block.settings.button_secondary_label }}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

