{% comment %}
  Section: How to Identify Genuine Dr. Pen Devices
  Theme: ShinePro (Shopify OS 2.0)
  Version: 1.0.0
{% endcomment %}

{%- liquid
  assign section_id = 'drpen-auth-' | append: section.id
  assign animation_class = section.settings.enable_animations | default: true
  assign bg_color = section.settings.background_color | default: '#FFFFFF'
  assign checklist_blocks = section.blocks | where: 'type', 'checklist_item'
  assign badge_blocks = section.blocks | where: 'type', 'trust_badge'
  assign floating_blocks = section.blocks | where: 'type', 'floating_label'
-%}

<style>
  #{{ section_id }} {
    background-color: {{ section.settings.background_color | default: '#FFFFFF' }};
    {% if section.settings.background_gradient != blank %}
      background: {{ section.settings.background_gradient }};
    {% endif %}
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    {% if section.settings.enable_shadow %}
      box-shadow: 0 4px 40px rgba(0,0,0,0.06);
    {% endif %}
    {% if section.settings.border_radius > 0 %}
      border-radius: {{ section.settings.border_radius }}px;
      overflow: hidden;
    {% endif %}
    {% if section.settings.custom_class != blank %}{% endif %}
  }

  #{{ section_id }} .drpen__container {
    max-width: {{ section.settings.container_width | default: 1280 }}px;
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
  }

  #{{ section_id }} .drpen__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  /* ─── LEFT COLUMN ─── */

  #{{ section_id }} .drpen__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: {{ section.settings.eyebrow_size | default: 11 }}px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ section.settings.eyebrow_color | default: '#B8974A' }};
    margin-bottom: 20px;
  }

  #{{ section_id }} .drpen__eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px;
    height: 1.5px;
    background: {{ section.settings.eyebrow_color | default: '#B8974A' }};
    flex-shrink: 0;
  }

  #{{ section_id }} .drpen__heading {
    font-size: {{ section.settings.heading_size | default: 38 }}px;
    font-weight: {{ section.settings.heading_weight | default: '600' }};
    line-height: 1.18;
    color: {{ section.settings.heading_color | default: '#0D0D0D' }};
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    max-width: {{ section.settings.content_max_width | default: 520 }}px;
  }

  #{{ section_id }} .drpen__paragraph {
    font-size: {{ section.settings.paragraph_size | default: 15 }}px;
    font-weight: {{ section.settings.paragraph_weight | default: '400' }};
    line-height: 1.75;
    color: {{ section.settings.paragraph_color | default: '#4A4A4A' }};
    margin: 0 0 36px;
    max-width: {{ section.settings.content_max_width | default: 520 }}px;
  }

  /* ─── CHECKLIST ─── */

  #{{ section_id }} .drpen__checklist {
    list-style: none;
    margin: 0 0 {{ section.settings.checklist_bottom_spacing | default: 44 }}px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.checklist_item_spacing | default: 14 }}px;
  }

  #{{ section_id }} .drpen__checklist-item {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: {{ section.settings.checklist_font_size | default: 14 }}px;
    font-weight: {{ section.settings.checklist_font_weight | default: '500' }};
    color: {{ section.settings.checklist_text_color | default: '#1A1A1A' }};
  }

  #{{ section_id }} .drpen__checklist-icon {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: {{ section.settings.checklist_icon_bg | default: '#F5F0E8' }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  #{{ section_id }} .drpen__checklist-icon svg {
    width: 12px;
    height: 12px;
    stroke: {{ section.settings.checklist_icon_color | default: '#B8974A' }};
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ─── TRUST BADGES ─── */

  #{{ section_id }} .drpen__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 44px;
  }

  #{{ section_id }} .drpen__badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #1a1a1a;
  padding: 7px 14px;
  border: 1.5px solid #002e5c;
  border-radius: 4px;
  background: #ffffff;
  transition: all 0.25s ease;
}

#{{ section_id }} .drpen__badge:hover {
  background: #002e5c;
  border-color: #002e5c;
  color: #ffffff;
}

#{{ section_id }} .drpen__badge:hover svg {
  stroke: #ffffff;
}

  {% comment %} #{{ section_id }} .drpen__badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ section.settings.badge_text_color | default: '#3A3A3A' }};
    padding: 7px 14px;
    {% if section.settings.badge_border %}
      border: 1px solid {{ section.settings.badge_border_color | default: '#E0D9CC' }};
    {% endif %}
    border-radius: 4px;
    background: {{ section.settings.badge_bg | default: '#FAFAF8' }};
    transition: all 0.25s ease;
  } {% endcomment %}

  #{{ section_id }} .drpen__badge:hover {
    background: {{ section.settings.badge_hover_bg | default: '#F5F0E8' }};
    border-color: {{ section.settings.badge_hover_border | default: '#B8974A' }};
  }

  #{{ section_id }} .drpen__badge svg {
    width: 13px;
    height: 13px;
    stroke: {{ section.settings.badge_icon_color | default: '#B8974A' }};
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  /* ─── CTA BUTTON ─── */

  #{{ section_id }} .drpen__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 34px;
    border-radius: 3px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .drpen__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.08);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #{{ section_id }} .drpen__cta:hover::after {
    opacity: 1;
  }

  #{{ section_id }} .drpen__cta--filled {
    background: {{ section.settings.button_bg | default: '#0D0D0D' }};
    color: {{ section.settings.button_text_color | default: '#FFFFFF' }};
    border: 2px solid transparent;
  }

  #{{ section_id }} .drpen__cta--filled:hover {
    background: {{ section.settings.button_hover_bg | default: '#1A1A1A' }};
    transform: translateY(-1px);
    box-shadow: 0 8px 28px rgba(0,0,0,0.18);
  }

  #{{ section_id }} .drpen__cta--outline {
    background: transparent;
    color: {{ section.settings.button_outline_color | default: '#0D0D0D' }};
    border: 2px solid {{ section.settings.button_outline_color | default: '#0D0D0D' }};
  }

  #{{ section_id }} .drpen__cta--outline:hover {
    background: {{ section.settings.button_outline_color | default: '#0D0D0D' }};
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  #{{ section_id }} .drpen__cta--gold {
    background: {{ section.settings.button_gold_bg | default: '#B8974A' }};
    color: #FFFFFF;
    border: 2px solid transparent;
  }

  #{{ section_id }} .drpen__cta--gold:hover {
    background: #A3833E;
    transform: translateY(-1px);
    box-shadow: 0 8px 28px rgba(184,151,74,0.28);
  }

  #{{ section_id }} .drpen__cta-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  #{{ section_id }} .drpen__cta:hover .drpen__cta-arrow {
    transform: translateX(4px);
  }

  /* ─── RIGHT COLUMN ─── */

  #{{ section_id }} .drpen__visual {
    position: relative;
  }

  #{{ section_id }} .drpen__image-wrap {
    position: relative;
    border-radius: {{ section.settings.image_border_radius | default: 12 }}px;
    overflow: visible;
    {% if section.settings.image_shadow != 'none' %}
      {% if section.settings.image_shadow == 'soft' %}
        filter: drop-shadow(0 20px 40px rgba(0,0,0,0.10));
      {% elsif section.settings.image_shadow == 'medium' %}
        filter: drop-shadow(0 24px 56px rgba(0,0,0,0.14));
      {% elsif section.settings.image_shadow == 'strong' %}
        filter: drop-shadow(0 32px 72px rgba(0,0,0,0.22));
      {% endif %}
    {% endif %}
    width: 100%;
    background: transparent;
  }

  #{{ section_id }} .drpen__image-wrap img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ section.settings.image_border_radius | default: 12 }}px;
    object-fit: {{ section.settings.image_fit | default: 'contain' }};
    object-position: {{ section.settings.image_position | default: 'center center' }};
    transition: transform 0.6s ease;
  }

  #{{ section_id }} .drpen__image-wrap:hover img {
    transform: scale(1.015);
  }

  #{{ section_id }} .drpen__image-overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.image_overlay | default: 'rgba(0,0,0,0)' }};
    pointer-events: none;
  }

  /* ─── FLOATING LABELS ─── */

  #{{ section_id }} .drpen__float-label {
    position: absolute;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    pointer-events: none;
    transition: transform 0.3s ease;
  }

  #{{ section_id }} .drpen__float-label--glass {
    background: rgba(255,255,255,0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.6);
    box-shadow: 0 8px 24px rgba(0,0,0,0.10);
  }

  #{{ section_id }} .drpen__float-label--solid {
    background: #FFFFFF;
    border: 1px solid #EDEDED;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  }

  #{{ section_id }} .drpen__float-label--dark {
    background: rgba(13,13,13,0.92);
    color: #FFFFFF;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  #{{ section_id }} .drpen__float-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: {{ section.settings.float_dot_color | default: '#B8974A' }};
    flex-shrink: 0;
    animation: drpen-pulse 2.4s ease-in-out infinite;
  }

  @keyframes drpen-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(184,151,74,0.4); }
    50% { box-shadow: 0 0 0 5px rgba(184,151,74,0); }
  }

  /* ─── CONNECTOR LINE ─── */

  #{{ section_id }} .drpen__connector {
    position: absolute;
    pointer-events: none;
    z-index: 5;
    overflow: visible;
  }

  /* ─── ANIMATIONS ─── */

  {% if section.settings.enable_animations %}
    #{{ section_id }} .drpen__fade-in {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    #{{ section_id }} .drpen__fade-in.drpen--visible {
      opacity: 1;
      transform: translateY(0);
    }

    #{{ section_id }} .drpen__fade-in:nth-child(2) { transition-delay: 0.1s; }
    #{{ section_id }} .drpen__fade-in:nth-child(3) { transition-delay: 0.2s; }
    #{{ section_id }} .drpen__fade-in:nth-child(4) { transition-delay: 0.3s; }
    #{{ section_id }} .drpen__fade-in:nth-child(5) { transition-delay: 0.4s; }
    #{{ section_id }} .drpen__fade-in:nth-child(6) { transition-delay: 0.5s; }

    #{{ section_id }} .drpen__visual {
      opacity: 0;
      transform: translateX(24px);
      transition: opacity 0.8s ease 0.2s, transform 0.8s ease 0.2s;
    }

    #{{ section_id }} .drpen__visual.drpen--visible {
      opacity: 1;
      transform: translateX(0);
    }

    #{{ section_id }} .drpen__float-label {
      animation: drpen-float 5s ease-in-out infinite;
    }

    #{{ section_id }} .drpen__float-label:nth-of-type(2) {
      animation-delay: 1.8s;
    }

    @keyframes drpen-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-5px); }
    }
  {% endif %}

  /* ─── SEPARATOR LINE ─── */

  #{{ section_id }} .drpen__divider {
    width: 48px;
    height: 2px;
    background: linear-gradient(90deg, {{ section.settings.eyebrow_color | default: '#B8974A' }}, transparent);
    margin-bottom: 20px;
  }

  /* ─── RESPONSIVE ─── */

  @media (max-width: 1024px) {
    #{{ section_id }} .drpen__grid {
      gap: 48px;
    }
  }

  @media (max-width: 767px) {
    #{{ section_id }} .drpen__container {
      padding-left: 20px;
      padding-right: 20px;
    }

    #{{ section_id }} {
      padding-top: {{ section.settings.mobile_padding_top | default: 52 }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom | default: 52 }}px;
    }

    #{{ section_id }} .drpen__grid {
      {% if section.settings.mobile_stack_order == 'image_first' %}
        grid-template-columns: 1fr;
        grid-template-areas: 'image' 'content';
      {% else %}
        grid-template-columns: 1fr;
        grid-template-areas: 'content' 'image';
      {% endif %}
      gap: {{ section.settings.mobile_column_gap | default: 36 }}px;
    }

    #{{ section_id }} .drpen__content {
      {% if section.settings.mobile_stack_order == 'image_first' %}
        grid-area: content;
      {% endif %}
    }

    #{{ section_id }} .drpen__visual {
      {% if section.settings.mobile_stack_order == 'image_first' %}
        grid-area: image;
      {% endif %}
    }

    #{{ section_id }} .drpen__heading {
      font-size: {{ section.settings.mobile_heading_size | default: 26 }}px;
      max-width: 100%;
    }

    #{{ section_id }} .drpen__paragraph {
      font-size: {{ section.settings.mobile_paragraph_size | default: 14 }}px;
      max-width: 100%;
    }

    #{{ section_id }} .drpen__image-wrap img {
      max-height: {{ section.settings.mobile_image_height | default: 420 }}px;
      width: 100%;
      height: auto;
    }

    #{{ section_id }} .drpen__float-label {
      display: none;
    }

    #{{ section_id }} .drpen__badges {
      gap: 8px;
    }
  }

  {% if section.settings.custom_css != blank %}
    {{ section.settings.custom_css }}
  {% endif %}
</style>

<section
  id="{{ section_id }}"
  class="drpen-section{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}"
  aria-label="{{ section.settings.heading | default: 'How to Identify Genuine Dr. Pen Devices' | escape }}"
>
  <div class="drpen__container">
    <div class="drpen__grid">

      {%- comment -%} ─── LEFT COLUMN ─── {%- endcomment -%}
      <div class="drpen__content">

        {%- if section.settings.eyebrow_text != blank -%}
          <p class="drpen__eyebrow drpen__fade-in">
            {{- section.settings.eyebrow_text | escape -}}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="drpen__heading drpen__fade-in">
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}

        {%- if section.settings.paragraph != blank -%}
          <p class="drpen__paragraph drpen__fade-in">
            {{- section.settings.paragraph -}}
          </p>
        {%- endif -%}

        {%- if checklist_blocks.size > 0 -%}
          <ul class="drpen__checklist drpen__fade-in" role="list">
            {%- for block in checklist_blocks -%}
              <li class="drpen__checklist-item" {{ block.shopify_attributes }}>
                <span class="drpen__checklist-icon" aria-hidden="true">
                  {%- if block.settings.icon == 'check' or block.settings.icon == blank -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  {%- elsif block.settings.icon == 'shield' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                  {%- elsif block.settings.icon == 'star' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                    </svg>
                  {%- elsif block.settings.icon == 'award' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <circle cx="12" cy="8" r="6"></circle>
                      <path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"></path>
                    </svg>
                  {%- endif -%}
                </span>
                <span>{{- block.settings.text | default: 'Checklist item' | escape -}}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if badge_blocks.size > 0 -%}
          <div class="drpen__badges drpen__fade-in" role="list" aria-label="Trust badges">
            {%- for block in badge_blocks -%}
              <span class="drpen__badge" role="listitem" {{ block.shopify_attributes }}>
                {%- if block.settings.icon == 'shield' or block.settings.icon == blank -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                {%- elsif block.settings.icon == 'lock' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                {%- elsif block.settings.icon == 'truck' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                  </svg>
                {%- elsif block.settings.icon == 'star' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                {%- elsif block.settings.icon == 'check' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                {%- endif -%}
                {{- block.settings.text | default: 'Badge' | escape -}}
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.button_text != blank -%}
          <div class="drpen__fade-in">
            <a
              href="{{ section.settings.button_url | default: '#' }}"
              class="drpen__cta drpen__cta--{{ section.settings.button_style | default: 'filled' }}"
              {%- if section.settings.button_url == blank -%} aria-disabled="true"{%- endif -%}
            >
              {{- section.settings.button_text | escape -}}
              <svg class="drpen__cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        {%- endif -%}

      </div>

      {%- comment -%} ─── RIGHT COLUMN ─── {%- endcomment -%}
      <div class="drpen__visual">

        <div class="drpen__image-wrap">
          {%- if section.settings.main_image != blank -%}
            {{
              section.settings.main_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '480, 600, 750, 900',
                sizes: '(max-width: 767px) 100vw, 50vw',
                alt: section.settings.main_image.alt | default: section.settings.heading | escape
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'drpen__placeholder-svg' }}
          {%- endif -%}
          <div class="drpen__image-overlay" aria-hidden="true"></div>
        </div>

        {%- comment -%} Floating Labels {%- endcomment -%}
        {%- for block in floating_blocks -%}
          {%- assign float_style = 'left:' | append: block.settings.pos_x | append: '%;top:' | append: block.settings.pos_y | append: '%;' -%}
          <div
            class="drpen__float-label drpen__float-label--{{ block.settings.style | default: 'glass' }}"
            style="{{ float_style }} color: {{ block.settings.text_color | default: '#1A1A1A' }}; background: {{ block.settings.bg_color | default: 'rgba(255,255,255,0.88)' }};"
            aria-hidden="true"
            {{ block.shopify_attributes }}
          >
            <span class="drpen__float-dot"></span>
            {{- block.settings.label_text | default: 'Authentic' | escape -}}
          </div>

          {%- if block.settings.show_connector -%}
            <svg class="drpen__connector" style="left:{{ block.settings.pos_x }}%;top:{{ block.settings.pos_y }}%;width:40px;height:40px;" viewBox="0 0 40 40" aria-hidden="true">
              <line x1="0" y1="0" x2="40" y2="40" stroke="{{ section.settings.eyebrow_color | default: '#B8974A' }}" stroke-width="1" stroke-dasharray="3,3" opacity="0.5"/>
            </svg>
          {%- endif -%}

        {%- endfor -%}

      </div>
    </div>
  </div>
</section>

{%- if section.settings.enable_animations -%}
<script>
  (function() {
    var section = document.getElementById('{{ section_id }}');
    if (!section) return;
    var targets = section.querySelectorAll('.drpen__fade-in, .drpen__visual');
    if (!('IntersectionObserver' in window)) {
      targets.forEach(function(el) { el.classList.add('drpen--visible'); });
      return;
    }
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('drpen--visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    targets.forEach(function(el) { observer.observe(el); });
  })();
</script>
{%- endif -%}

