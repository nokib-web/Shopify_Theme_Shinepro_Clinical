<section
  id="learn-video-guides-{{ section.id }}"
  class="learn-video-guides-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.section_bg }};
  "
>

  <div class="learn-video-guides-wrapper">

    {% if section.settings.subheading != blank %}
      <div class="learn-video-subheading">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="learn-video-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="learn-video-description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    <div class="learn-video-grid">

      {% for block in section.blocks %}

        <div
          class="learn-video-card"
          {{ block.shopify_attributes }}
        >

          <div class="learn-video-embed">

            {% if block.settings.video_url != blank %}

              <iframe
                src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}"
                title="{{ block.settings.title }}"
                frameborder="0"
                allowfullscreen
                loading="lazy"
              ></iframe>

            {% endif %}

          </div>

          <div class="learn-video-content">

            {% if block.settings.title != blank %}
              <h3 class="learn-video-card-title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="learn-video-card-text">
                {{ block.settings.text }}
              </div>
            {% endif %}

          </div>

        </div>

      {% endfor %}

    </div>

  </div>

</section>

<style>

#learn-video-guides-{{ section.id }} .learn-video-guides-wrapper{
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
  padding-left: 20px;
  padding-right: 20px;
}

#learn-video-guides-{{ section.id }} .learn-video-subheading{
  text-align: center;
  margin-bottom: 12px;

  color: {{ section.settings.subheading_color }};
  font-size: {{ section.settings.subheading_size }}px;
}

#learn-video-guides-{{ section.id }} .learn-video-heading{
  text-align: center;
  margin: 0 0 16px;

  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  line-height: 1.2;
}

#learn-video-guides-{{ section.id }} .learn-video-description{
  max-width: 760px;
  margin: 0 auto 50px;

  text-align: center;

  color: {{ section.settings.description_color }};
  font-size: {{ section.settings.description_size }}px;
  line-height: 1.7;
}

#learn-video-guides-{{ section.id }} .learn-video-grid{
  display: grid;
  grid-template-columns: repeat({{ section.settings.desktop_columns }},1fr);
  gap: {{ section.settings.grid_gap }}px;
}

#learn-video-guides-{{ section.id }} .learn-video-card{
  overflow: hidden;

  border-radius: {{ section.settings.card_radius }}px;

  background: {{ section.settings.card_bg }};
  border: 1px solid {{ section.settings.card_border }};

  transition: all .3s ease;
}

#learn-video-guides-{{ section.id }} .learn-video-card:hover{
  transform: translateY(-5px);
}

#learn-video-guides-{{ section.id }} .learn-video-embed{
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
}

#learn-video-guides-{{ section.id }} .learn-video-embed iframe{
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;
}

#learn-video-guides-{{ section.id }} .learn-video-content{
  padding:
    {{ section.settings.content_padding_top }}px
    {{ section.settings.content_padding_side }}px
    {{ section.settings.content_padding_bottom }}px;
}

#learn-video-guides-{{ section.id }} .learn-video-card-title{
  margin: 0 0 14px;

  color: {{ section.settings.title_color }};
  font-size: {{ section.settings.title_size }}px;
  line-height: 1.3;
}

#learn-video-guides-{{ section.id }} .learn-video-card-text{
  color: {{ section.settings.text_color }};
  font-size: {{ section.settings.text_size }}px;
  line-height: 1.7;
}

@media screen and (max-width: 991px){

  #learn-video-guides-{{ section.id }} .learn-video-grid{
    grid-template-columns: repeat({{ section.settings.tablet_columns }},1fr);
  }

  #learn-video-guides-{{ section.id }} .learn-video-heading{
    font-size: {{ section.settings.heading_size_tablet }}px;
  }

}

@media screen and (max-width: 767px){

  #learn-video-guides-{{ section.id }} .learn-video-grid{
    display: flex;
    overflow-x: auto;

    gap: 16px;

    scroll-snap-type: x mandatory;
  }

  #learn-video-guides-{{ section.id }} .learn-video-grid::-webkit-scrollbar{
    display: none;
  }

  #learn-video-guides-{{ section.id }} .learn-video-card{
    min-width: {{ section.settings.mobile_card_width }}px;
    scroll-snap-align: start;
  }

  #learn-video-guides-{{ section.id }} .learn-video-heading{
    font-size: {{ section.settings.heading_size_mobile }}px;
  }

}

</style>

{% schema %}
{
  "name": "Learn Video Guides",

  "settings": [

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Video Tutorials"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch Professional Tutorials"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Learn microneedling techniques, skincare routines, and device setup with step-by-step video tutorials."
    },

    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Desktop Columns",
      "default": 3
    },

    {
      "type": "range",
      "id": "tablet_columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Tablet Columns",
      "default": 2
    },

    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap",
      "default": 24
    },

    {
      "type": "range",
      "id": "mobile_card_width",
      "min": 240,
      "max": 420,
      "step": 10,
      "unit": "px",
      "label": "Mobile Card Width",
      "default": 300
    },

    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Container Width",
      "default": 1400
    },

    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card Radius",
      "default": 20
    },

    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#ffffff"
    },

    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#f9f7f4"
    },

    {
      "type": "color",
      "id": "card_border",
      "label": "Card Border",
      "default": "#eeeeee"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#8b7355"
    },

    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#666666"
    },

    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    },

    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop Heading Size",
      "default": 48
    },

    {
      "type": "range",
      "id": "heading_size_tablet",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Tablet Heading Size",
      "default": 40
    },

    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 20,
      "max": 46,
      "step": 2,
      "unit": "px",
      "label": "Mobile Heading Size",
      "default": 30
    },

    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size",
      "default": 16
    },

    {
      "type": "range",
      "id": "description_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description Size",
      "default": 17
    },

    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 34,
      "step": 1,
      "unit": "px",
      "label": "Title Size",
      "default": 24
    },

    {
      "type": "range",
      "id": "text_size",
      "min": 13,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 15
    },

    {
      "type": "range",
      "id": "content_padding_top",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Content Top Padding",
      "default": 24
    },

    {
      "type": "range",
      "id": "content_padding_bottom",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Content Bottom Padding",
      "default": 24
    },

    {
      "type": "range",
      "id": "content_padding_side",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Content Side Padding",
      "default": 24
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Section Top Padding",
      "default": 80
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "label": "Section Bottom Padding",
      "default": 80
    }

  ],

  "blocks": [
    {
      "type": "video",

      "name": "Video",

      "settings": [

        {
          "type": "video_url",
          "id": "video_url",
          "label": "YouTube URL",
          "accept": ["youtube"]
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Microneedling Tutorial"
        },

        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Learn proper microneedling techniques and skincare routines."
        }

      ]
    }
  ],

  "presets": [
    {
      "name": "Learn Video Guides"
    }
  ]
}
{% endschema %}