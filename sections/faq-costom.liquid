{%- style -%}
  /* CSS Variables for Colors */
  #FAQ-{{ section.id }} {
    --bg-section: {{ section.settings.bg_color }};
    --bg-item-closed: {{ section.settings.item_bg_closed }};
    --bg-item-open: {{ section.settings.item_bg_open }};
    --bg-icon-closed: {{ section.settings.icon_bg_closed }};
    --bg-icon-open: {{ section.settings.icon_bg_open }};
    
    --color-title: {{ section.settings.title_color }};
    --color-subtitle: {{ section.settings.subtitle_color }};
    --color-question: {{ section.settings.question_color }};
    --color-answer: {{ section.settings.answer_color }};
    --color-icon: {{ section.settings.icon_color }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background-color: var(--bg-section);
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .custom-faq-wrapper {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    font-family: inherit;
  }

  .custom-faq-header {
    text-align: center;
    margin-bottom: 40px;
  }

  /* Typography: Mobile First */
  .custom-faq-subtitle {
    font-size: {{ section.settings.subtitle_size_mobile }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-subtitle);
    margin-bottom: 12px;
  }

  .custom-faq-title {
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: 500;
    color: var(--color-title);
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .custom-faq-question-text {
    font-size: {{ section.settings.question_size_mobile }}px;
    font-weight: 600;
    padding-right: 20px;
    pointer-events: none;
    color: var(--color-question);
  }

  .custom-faq-answer-inner {
    padding: 0 24px 24px 24px;
    font-size: {{ section.settings.answer_size_mobile }}px;
    line-height: 1.6;
    color: var(--color-answer);
  }

  /* Typography: Desktop */
  @media screen and (min-width: 768px) {
    .custom-faq-subtitle { font-size: {{ section.settings.subtitle_size_desktop }}px; }
    .custom-faq-title { font-size: {{ section.settings.title_size_desktop }}px; }
    .custom-faq-question-text { font-size: {{ section.settings.question_size_desktop }}px; }
    .custom-faq-answer-inner { 
      font-size: {{ section.settings.answer_size_desktop }}px; 
      padding: 0 32px 32px 32px;
    }
  }

  /* Layout & Accordion Styles */
  .custom-faq-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .custom-faq-item {
    background-color: var(--bg-item-closed);
    border-radius: 50px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .custom-faq-item.is-active {
    background-color: var(--bg-item-open);
    border-radius: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .custom-faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  @media screen and (min-width: 768px) {
    .custom-faq-question {
      padding: 20px 32px;
    }
  }

  .custom-faq-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--bg-icon-closed);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    pointer-events: none;
  }

  .custom-faq-item.is-active .custom-faq-icon {
    background-color: var(--bg-icon-open);
  }

  .custom-faq-icon svg {
    width: 12px;
    height: 12px;
    color: var(--color-icon);
    transition: transform 0.3s ease;
  }

  .icon-plus { display: block; }
  .icon-minus { display: none; }

  .custom-faq-item.is-active .icon-plus { display: none; }
  .custom-faq-item.is-active .icon-minus { display: block; }

  .custom-faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .custom-faq-answer-inner p {
    margin: 0 0 10px 0;
  }
  .custom-faq-answer-inner p:last-child {
    margin: 0;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding" id="FAQ-{{ section.id }}">
  <div class="custom-faq-wrapper">
    
    <div class="custom-faq-header">
      {%- if section.settings.subtitle != blank -%}
        <div class="custom-faq-subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="custom-faq-title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    <div class="custom-faq-list">
      {%- for block in section.blocks -%}
        <div class="custom-faq-item {% if forloop.first and section.settings.open_first %}is-active{% endif %}" {{ block.shopify_attributes }}>
          <button class="custom-faq-question" aria-expanded="{% if forloop.first and section.settings.open_first %}true{% else %}false{% endif %}">
            <span class="custom-faq-question-text">{{ block.settings.question }}</span>
            <span class="custom-faq-icon">
              <svg class="icon-plus" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 1V13M1 7H13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <svg class="icon-minus" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
          
          <div class="custom-faq-answer" {% if forloop.first and section.settings.open_first %}style="max-height: 1000px;"{% endif %}>
            <div class="custom-faq-answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<script>
  function initFaqAccordion() {
    const faqLists = document.querySelectorAll('#FAQ-{{ section.id }} .custom-faq-list');
    
    faqLists.forEach(list => {
      const items = list.querySelectorAll('.custom-faq-item');
      
      items.forEach(item => {
        const button = item.querySelector('.custom-faq-question');
        const answer = item.querySelector('.custom-faq-answer');
        
        const newButton = button.cloneNode(true);
        button.parentNode.replaceChild(newButton, button);
        
        newButton.addEventListener('click', function(e) {
          e.preventDefault();
          const isActive = item.classList.contains('is-active');

          if (!isActive) {
            item.classList.add('is-active');
            this.setAttribute('aria-expanded', 'true');
            answer.style.maxHeight = answer.scrollHeight + 50 + "px"; 
          } else {
            item.classList.remove('is-active');
            this.setAttribute('aria-expanded', 'false');
            answer.style.maxHeight = null;
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initFaqAccordion);
  document.addEventListener('shopify:section:load', initFaqAccordion);
</script>

