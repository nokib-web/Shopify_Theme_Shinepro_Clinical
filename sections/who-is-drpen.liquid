{% comment %}
  ============================================================
  Section: Dr. Pen — "Who is Dr. Pen" + Timeline Section
  Layout:
    - Left:  Badge, Heading (italic brand), Tagline, Bullets, Stats Grid
    - Right: Animated vertical timeline with card items + tags
  Features:
    - Scroll-triggered fade+slide animation on timeline items
    - Hover effects on bullets and timeline cards
    - Gradient brand name in heading
    - Color-coded timeline tags (milestone / certification / future)
    - Stats grid (2×2)
    - Fully responsive (Desktop / Tablet / Mobile)
    - All values controlled via Shopify section settings
    - Font family inherited from global theme
  ============================================================
{% endcomment %}

{%- liquid
  assign sid = 'drpen-who-' | append: section.id
-%}

<style>
  /* ===================== RESET ===================== */
  #{{ sid }} *,
  #{{ sid }} *::before,
  #{{ sid }} *::after {
    box-sizing: border-box;
  }

  /* ===================== SECTION WRAPPER ===================== */
  #{{ sid }} {
    background-color: {{ section.settings.bg_color }};
    padding-top:    {{ section.settings.desktop_pt }}px;
    padding-bottom: {{ section.settings.desktop_pb }}px;
    padding-left:   {{ section.settings.desktop_plr }}px;
    padding-right:  {{ section.settings.desktop_plr }}px;
    margin-top:    {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    font-family: inherit;
  }

  #{{ sid }} .who-inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: {{ section.settings.desktop_left_width }}fr {{ section.settings.desktop_right_width }}fr;
    gap: {{ section.settings.desktop_col_gap }}px;
    align-items: start;
  }

  /* ===================== ENTRY ANIMATIONS ===================== */
  @keyframes {{ sid }}-fadeDown {
    from { opacity: 0; transform: translateY(-14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes {{ sid }}-slideIn {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* ===================== BADGE ===================== */
  #{{ sid }} .who-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_color }};
    font-size: 12px;
    font-weight: 500;
    padding: 5px 14px;
    border-radius: 20px;
    border: 0.5px solid {{ section.settings.badge_border }};
    margin-bottom: {{ section.settings.badge_mb }}px;
    animation: {{ sid }}-fadeDown 0.5s ease both;
  }

  #{{ sid }} .who-badge svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: {{ section.settings.badge_icon_color }};
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  /* ===================== LEFT PANEL ===================== */
  #{{ sid }} .who-left {
    padding-right: {{ section.settings.left_padding_right }}px;
  }

  /* Main heading */
  #{{ sid }} .who-heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.desktop_heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.15;
    margin: 0 0 {{ section.settings.heading_mb }}px 0;
    font-family: inherit;
    animation: {{ sid }}-fadeDown 0.6s 0.1s ease both;
  }

  /* Italic brand — gradient */
  #{{ sid }} .who-heading em {
    font-style: italic;
    font-weight: {{ section.settings.heading_italic_weight }};
    background: linear-gradient(135deg, {{ section.settings.heading_italic_color }}, {{ section.settings.heading_italic_color2 }});
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Superscript ® */
  #{{ sid }} .who-heading sup {
    font-size: 0.42em;
    vertical-align: super;
    font-style: normal;
    font-weight: {{ section.settings.heading_weight }};
    -webkit-text-fill-color: {{ section.settings.heading_italic_color }};
    color: {{ section.settings.heading_italic_color }};
  }

  /* Tagline */
  #{{ sid }} .who-tagline {
    color: {{ section.settings.tagline_color }};
    font-size: {{ section.settings.desktop_tagline_size }}px;
    font-weight: {{ section.settings.tagline_weight }};
    line-height: {{ section.settings.tagline_line_height }};
    margin: 0 0 {{ section.settings.tagline_mb }}px 0;
    font-family: inherit;
    animation: {{ sid }}-fadeDown 0.6s 0.2s ease both;
  }

  /* ===================== BULLET LIST ===================== */
  #{{ sid }} .who-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.bullet_gap }}px;
    animation: {{ sid }}-fadeDown 0.6s 0.3s ease both;
  }

  #{{ sid }} .who-bullet {
    display: flex;
    align-items: flex-start;
    gap: {{ section.settings.bullet_icon_gap }}px;
    background: {{ section.settings.bullet_card_bg }};
    border: 0.5px solid {{ section.settings.bullet_card_border }};
    border-radius: {{ section.settings.bullet_card_radius }}px;
    padding: {{ section.settings.bullet_card_py }}px {{ section.settings.bullet_card_px }}px;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  #{{ sid }} .who-bullet:hover {
    transform: translateX(5px);
    box-shadow: 0 4px 18px rgba(20, 70, 160, 0.09);
  }

  #{{ sid }} .who-bullet-icon-wrap {
    flex-shrink: 0;
    width: {{ section.settings.bullet_icon_wrap_size }}px;
    height: {{ section.settings.bullet_icon_wrap_size }}px;
    border-radius: {{ section.settings.bullet_icon_wrap_radius }}px;
    background: linear-gradient(135deg, {{ section.settings.bullet_icon_bg1 }}, {{ section.settings.bullet_icon_bg2 }});
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ sid }} .who-bullet-icon-wrap svg {
    width: {{ section.settings.bullet_icon_size }}px;
    height: {{ section.settings.bullet_icon_size }}px;
    fill: none;
    stroke: {{ section.settings.bullet_icon_color }};
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #{{ sid }} .who-bullet-icon-emoji {
    flex-shrink: 0;
    font-size: {{ section.settings.bullet_icon_size }}px;
    line-height: 1.4;
    display: flex;
    align-items: center;
  }

  #{{ sid }} .who-bullet-text {
    color: {{ section.settings.bullet_text_color }};
    font-size: {{ section.settings.desktop_bullet_size }}px;
    font-weight: {{ section.settings.bullet_text_weight }};
    line-height: 1.55;
    font-family: inherit;
    padding-top: 4px;
  }

  /* ===================== DIVIDER + STATS ===================== */
  #{{ sid }} .who-divider {
    width: {{ section.settings.divider_width }}px;
    height: {{ section.settings.divider_height }}px;
    background: linear-gradient(90deg, {{ section.settings.heading_italic_color }}, {{ section.settings.heading_italic_color2 }});
    border-radius: 2px;
    margin: {{ section.settings.divider_my }}px 0;
    animation: {{ sid }}-fadeDown 0.5s 0.4s ease both;
  }

  #{{ sid }} .who-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.stats_gap }}px;
    animation: {{ sid }}-fadeDown 0.6s 0.5s ease both;
  }

  #{{ sid }} .who-stat {
    background: {{ section.settings.stat_bg }};
    border: 0.5px solid {{ section.settings.stat_border }};
    border-radius: {{ section.settings.stat_radius }}px;
    padding: {{ section.settings.stat_py }}px {{ section.settings.stat_px }}px;
    text-align: center;
  }

  #{{ sid }} .who-stat-num {
    font-size: {{ section.settings.stat_num_size }}px;
    font-weight: 700;
    color: {{ section.settings.stat_num_color }};
    line-height: 1;
  }

  #{{ sid }} .who-stat-label {
    font-size: {{ section.settings.stat_label_size }}px;
    color: {{ section.settings.stat_label_color }};
    margin-top: 4px;
    font-weight: 400;
  }

  /* ===================== RIGHT PANEL — TIMELINE ===================== */
  #{{ sid }} .who-right {
    position: relative;
  }

  #{{ sid }} .who-tl-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.09em;
    color: {{ section.settings.tl_title_color }};
    text-transform: uppercase;
    margin-bottom: {{ section.settings.tl_title_mb }}px;
    animation: {{ sid }}-fadeDown 0.5s 0.1s ease both;
  }

  #{{ sid }} .who-timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Vertical dashed line */
  #{{ sid }} .who-timeline::before {
    content: '';
    position: absolute;
    left: {{ section.settings.timeline_line_left }}px;
    top: {{ section.settings.timeline_dot_size | divided_by: 2 | plus: 2 }}px;
    bottom: 10px;
    width: 0;
    border-left: {{ section.settings.timeline_line_width }}px dashed {{ section.settings.timeline_line_color }};
    transform: translateX(-50%);
    opacity: 0.85;
  }

  #{{ sid }} .who-tl-item {
    display: grid;
    grid-template-columns: {{ section.settings.timeline_year_width }}px {{ section.settings.timeline_dot_col_width }}px 1fr;
    gap: 0 {{ section.settings.timeline_col_gap }}px;
    align-items: start;
    margin-bottom: {{ section.settings.timeline_item_gap }}px;
    position: relative;
    /* JS animates these */
    opacity: 0;
    transform: translateX(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  #{{ sid }} .who-tl-item:last-child {
    margin-bottom: 0;
  }

  #{{ sid }} .who-tl-item.drpen-visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* Year label */
  #{{ sid }} .who-tl-year {
    text-align: right;
    color: {{ section.settings.year_color }};
    font-size: {{ section.settings.desktop_year_size }}px;
    font-weight: {{ section.settings.year_weight }};
    line-height: 1.3;
    padding-top: 6px;
    font-family: inherit;
    white-space: pre-line;
  }

  #{{ sid }} .who-tl-year--future {
    color: {{ section.settings.year_future_color }};
  }

  /* Dot column */
  #{{ sid }} .who-tl-dot-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  #{{ sid }} .who-tl-dot {
    width:  {{ section.settings.timeline_dot_size }}px;
    height: {{ section.settings.timeline_dot_size }}px;
    border-radius: 50%;
    border: {{ section.settings.timeline_dot_border }}px solid {{ section.settings.timeline_dot_color }};
    background: {{ section.settings.bg_color }};
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    margin-top: 4px;
    transition: transform 0.28s ease, background 0.28s ease, box-shadow 0.28s ease;
  }

  #{{ sid }} .who-tl-item:hover .who-tl-dot {
    background: {{ section.settings.timeline_dot_color }};
    transform: scale(1.4);
    box-shadow: 0 0 0 5px {{ section.settings.timeline_dot_glow }};
  }

  #{{ sid }} .who-tl-dot--future {
    border-color: {{ section.settings.dot_future_color }};
    background: {{ section.settings.bg_color }};
  }

  #{{ sid }} .who-tl-item:hover .who-tl-dot--future {
    background: {{ section.settings.dot_future_color }};
    box-shadow: 0 0 0 5px {{ section.settings.dot_future_glow }};
  }

  /* Timeline card */
  #{{ sid }} .who-tl-card {
    background: {{ section.settings.tl_card_bg }};
    border: 0.5px solid {{ section.settings.tl_card_border }};
    border-radius: {{ section.settings.tl_card_radius }}px;
    padding: {{ section.settings.tl_card_py }}px {{ section.settings.tl_card_px }}px;
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
    padding-bottom: {{ section.settings.timeline_item_gap | divided_by: 2 }}px;
  }

  #{{ sid }} .who-tl-item:hover .who-tl-card {
    box-shadow: 0 4px 18px rgba(20, 70, 160, 0.09);
    border-color: {{ section.settings.tl_card_border_hover }};
  }

  /* Description */
  #{{ sid }} .who-tl-desc {
    color: {{ section.settings.desc_color }};
    font-size: {{ section.settings.desktop_desc_size }}px;
    font-weight: {{ section.settings.desc_weight }};
    line-height: 1.65;
    font-family: inherit;
  }

  /* Timeline tags */
  #{{ sid }} .who-tl-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 9px;
    border-radius: 20px;
    margin-top: 7px;
  }

  #{{ sid }} .who-tl-tag--milestone {
    background: {{ section.settings.tag_milestone_bg }};
    color: {{ section.settings.tag_milestone_color }};
  }

  #{{ sid }} .who-tl-tag--cert {
    background: {{ section.settings.tag_cert_bg }};
    color: {{ section.settings.tag_cert_color }};
  }

  #{{ sid }} .who-tl-tag--future {
    background: {{ section.settings.tag_future_bg }};
    color: {{ section.settings.tag_future_color }};
  }

  /* ===================== TABLET (≤1024px) ===================== */
  @media screen and (max-width: 1024px) {
    #{{ sid }} .who-inner {
      grid-template-columns: 1fr 1fr;
      gap: {{ section.settings.tablet_col_gap }}px;
    }
    #{{ sid }} .who-heading     { font-size: {{ section.settings.tablet_heading_size }}px; }
    #{{ sid }} .who-tagline     { font-size: {{ section.settings.tablet_tagline_size }}px; }
    #{{ sid }} .who-bullet-text { font-size: {{ section.settings.tablet_bullet_size }}px; }
    #{{ sid }} .who-tl-year     { font-size: {{ section.settings.tablet_year_size }}px; }
    #{{ sid }} .who-tl-desc     { font-size: {{ section.settings.tablet_desc_size }}px; }
  }

  /* ===================== MOBILE (≤749px) ===================== */
  @media screen and (max-width: 749px) {
    #{{ sid }} {
      padding-top:    {{ section.settings.mobile_pt }}px;
      padding-bottom: {{ section.settings.mobile_pb }}px;
      padding-left:   {{ section.settings.mobile_plr }}px;
      padding-right:  {{ section.settings.mobile_plr }}px;
    }
    #{{ sid }} .who-inner {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_col_gap }}px;
    }
    #{{ sid }} .who-left         { padding-right: 0; }
    #{{ sid }} .who-heading      { font-size: {{ section.settings.mobile_heading_size }}px; }
    #{{ sid }} .who-tagline      { font-size: {{ section.settings.mobile_tagline_size }}px; }
    #{{ sid }} .who-bullet-text  { font-size: {{ section.settings.mobile_bullet_size }}px; }
    #{{ sid }} .who-tl-year      { font-size: {{ section.settings.mobile_year_size }}px; }
    #{{ sid }} .who-tl-desc      { font-size: {{ section.settings.mobile_desc_size }}px; }
    #{{ sid }} .who-tl-item      { margin-bottom: {{ section.settings.mobile_tl_item_gap }}px; }
    #{{ sid }} .who-timeline::before {
      left: {{ section.settings.mobile_timeline_line_left }}px;
    }
    #{{ sid }} .who-tl-item {
      grid-template-columns: {{ section.settings.mobile_year_width }}px {{ section.settings.timeline_dot_col_width }}px 1fr;
    }
  }
</style>

<section id="{{ sid }}" class="drpen-who-wrapper">
  <div class="who-inner">

    <!-- ===== LEFT PANEL ===== -->
    <div class="who-left">

      {%- if section.settings.badge_text != blank -%}
        <div class="who-badge">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/>
          </svg>
          {{ section.settings.badge_text }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading_prefix != blank or section.settings.heading_brand != blank -%}
        <h2 class="who-heading">
          {{- section.settings.heading_prefix -}}
          {%- if section.settings.heading_brand != blank -%}
            &nbsp;<em>{{ section.settings.heading_brand }}</em>
            {%- if section.settings.show_registered -%}<sup>®</sup>{%- endif -%}
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="who-tagline">{{ section.settings.tagline | newline_to_br }}</p>
      {%- endif -%}

      {%- assign bullet_blocks = section.blocks | where: 'type', 'bullet' -%}
      {%- if bullet_blocks.size > 0 -%}
        <ul class="who-bullets">
          {%- for block in bullet_blocks -%}
            <li class="who-bullet" {{ block.shopify_attributes }}>
              {%- if block.settings.show_icon -%}
                {%- if block.settings.icon_type == 'svg' and block.settings.icon_svg != blank -%}
                  <span class="who-bullet-icon-wrap">
                    {{ block.settings.icon_svg }}
                  </span>
                {%- elsif block.settings.icon_type == 'emoji' and block.settings.icon_text != blank -%}
                  <span class="who-bullet-icon-emoji" aria-hidden="true">{{ block.settings.icon_text }}</span>
                {%- else -%}
                  <span class="who-bullet-icon-wrap" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/>
                    </svg>
                  </span>
                {%- endif -%}
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <span class="who-bullet-text">{{ block.settings.text }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <div class="who-divider" aria-hidden="true"></div>
      {%- endif -%}

      {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
      {%- if stat_blocks.size > 0 -%}
        <div class="who-stats">
          {%- for block in stat_blocks -%}
            <div class="who-stat" {{ block.shopify_attributes }}>
              <div class="who-stat-num">{{ block.settings.number }}</div>
              <div class="who-stat-label">{{ block.settings.label }}</div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

    <!-- ===== RIGHT PANEL — TIMELINE ===== -->
    <div class="who-right">
      {%- if section.settings.timeline_section_title != blank -%}
        <div class="who-tl-title">{{ section.settings.timeline_section_title }}</div>
      {%- endif -%}

      {%- assign tl_blocks = section.blocks | where: 'type', 'timeline_item' -%}
      {%- if tl_blocks.size > 0 -%}
        <ul class="who-timeline" id="who-tl-{{ section.id }}">
          {%- for block in tl_blocks -%}
            <li class="who-tl-item" {{ block.shopify_attributes }}>
              <div class="who-tl-year{% if block.settings.year_style == 'future' %} who-tl-year--future{% endif %}">
                {{- block.settings.year -}}
              </div>
              <div class="who-tl-dot-col">
                <div class="who-tl-dot{% if block.settings.year_style == 'future' %} who-tl-dot--future{% endif %}"></div>
              </div>
              <div class="who-tl-card">
                <div class="who-tl-desc">{{ block.settings.description }}</div>
                {%- if block.settings.tag != blank -%}
                  <span class="who-tl-tag who-tl-tag--{{ block.settings.tag_style }}">{{ block.settings.tag }}</span>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

  </div>
</section>

<script>
(function() {
  var tlId = 'who-tl-{{ section.id }}';
  var items = document.querySelectorAll('#' + tlId + ' .who-tl-item');
  if (!items.length) return;

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry, idx) {
        if (entry.isIntersecting) {
          var el = entry.target;
          var delay = Array.prototype.indexOf.call(items, el) * 80;
          setTimeout(function() { el.classList.add('drpen-visible'); }, delay);
          io.unobserve(el);
        }
      });
    }, { threshold: 0.15 });
    items.forEach(function(el) { io.observe(el); });
  } else {
    items.forEach(function(el) { el.classList.add('drpen-visible'); });
  }
})();
</script>

{% schema %}
{
  "name": "DrPen Who Is Section",
  "tag": "section",
  "class": "drpen-who-section",
  "settings": [

    {
      "type": "header",
      "content": "🏷️ Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Est. 2008 · 17 Years of Innovation",
      "info": "Leave blank to hide the badge"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Background",
      "default": "#e8ecf5"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Text Color",
      "default": "#1a3a6b"
    },
    {
      "type": "color",
      "id": "badge_border",
      "label": "Badge Border Color",
      "default": "#c5cee8"
    },
    {
      "type": "color",
      "id": "badge_icon_color",
      "label": "Badge Icon Stroke Color",
      "default": "#4a6fa5"
    },
    {
      "type": "range",
      "id": "badge_mb",
      "label": "Badge Margin Bottom (px)",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 20
    },

    {
      "type": "header",
      "content": "📝 Left Panel — Heading"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix Text",
      "default": "Who is",
      "info": "Normal-weight part of the heading"
    },
    {
      "type": "text",
      "id": "heading_brand",
      "label": "Brand Name (italic + gradient)",
      "default": "Dr. Pen",
      "info": "Rendered as italic gradient text"
    },
    {
      "type": "checkbox",
      "id": "show_registered",
      "label": "Show ® after brand name",
      "default": true
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline (line breaks supported)",
      "default": "Built in China\nBacked Globally.\nGrowing Fast in the U.S. and Europe."
    },

    {
      "type": "header",
      "content": "🎨 Section Background & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f0f3f7"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section Max Width (px)",
      "min": 600,
      "max": 1800,
      "step": 50,
      "default": 1100
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },

