{% comment %}
  Contact Help Banner Section
  Pixel-perfect Shopify Liquid section
  Fully customizable via Theme Editor
{% endcomment %}

{%- liquid
  assign section_id = 'contact-help-banner-' | append: section.id
-%}

<style>
  #{{ section_id }} {
    background-color: {{ section.settings.bg_color }};
    {%- if section.settings.bg_image != blank -%}
    background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
    background-size: {{ section.settings.bg_image_size }};
    background-position: {{ section.settings.bg_image_position }};
    background-repeat: {{ section.settings.bg_image_repeat }};
    {%- endif -%}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    position: relative;
  }

  #{{ section_id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 1;
  }

  @media screen and (max-width: 767px) {
    #{{ section_id }}::before {
      background-color: {{ section.settings.mobile_overlay_color }};
      opacity: {{ section.settings.mobile_overlay_opacity | divided_by: 100.0 }};
    }
  }

  #{{ section_id }} .chb__container {
    max-width: {{ section.settings.section_max_width }}px;
    margin: 0 auto;
    padding-left: {{ section.settings.padding_horizontal }}px;
    padding-right: {{ section.settings.padding_horizontal }}px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    position: relative;
    z-index: 2;
  }

  #{{ section_id }} .chb__content {
    flex: 1;
    min-width: 0;
  }

  #{{ section_id }} .chb__eyebrow {
    display: inline-block;
    font-size: {{ section.settings.eyebrow_font_size }}px;
    font-weight: {{ section.settings.eyebrow_font_weight }};
    color: {{ section.settings.eyebrow_color }};
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  #{{ section_id }} .chb__heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_color }};
    line-height: 1.2;
    margin: 0 0 14px 0;
    padding: 0;
  }

  #{{ section_id }} .chb__subtext {
    font-size: {{ section.settings.subtext_font_size }}px;
    font-weight: {{ section.settings.subtext_font_weight }};
    color: {{ section.settings.subtext_color }};
    line-height: 1.6;
    margin: 0 0 28px 0;
    max-width: 460px;
  }

  #{{ section_id }} .chb__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
  }

  #{{ section_id }} .chb__badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ section.settings.badge_font_size }}px;
    font-weight: {{ section.settings.badge_font_weight }};
    color: {{ section.settings.badge_text_color }};
  }

  #{{ section_id }} .chb__badge-icon {
    width: {{ section.settings.badge_icon_size }}px;
    height: {{ section.settings.badge_icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: {{ section.settings.badge_icon_color }};
  }

  #{{ section_id }} .chb__badge-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #{{ section_id }} .chb__badge-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Image Area */
  #{{ section_id }} .chb__image-wrap {
    flex-shrink: 0;
    width: {{ section.settings.image_width }}px;
    max-width: 50%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  #{{ section_id }} .chb__image-wrap img {
    width: 100%;
    height: {{ section.settings.image_height }}px;
    object-fit: {{ section.settings.image_object_fit }};
    display: block;
  }

  /* ========================
     TABLET — max-width: 1024px
     ======================== */
  @media screen and (max-width: 1024px) {
    #{{ section_id }} .chb__container {
      gap: 24px;
    }

    #{{ section_id }} .chb__image-wrap {
      width: {{ section.settings.tablet_image_width }}px;
    }

    #{{ section_id }} .chb__heading {
      font-size: {{ section.settings.tablet_heading_font_size }}px;
    }

    #{{ section_id }} .chb__subtext {
      font-size: {{ section.settings.tablet_subtext_font_size }}px;
    }
  }

  /* ========================
     MOBILE — max-width: 767px
     ======================== */
  @media screen and (max-width: 767px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .chb__container {
      flex-direction: {{ section.settings.mobile_layout }};
      padding-left: {{ section.settings.mobile_padding_horizontal }}px;
      padding-right: {{ section.settings.mobile_padding_horizontal }}px;
      gap: 20px;
      align-items: flex-start;
    }

    #{{ section_id }} .chb__image-wrap {
      width: 100%;
      max-width: 100%;
      justify-content: center;
      order: {{ section.settings.mobile_image_order }};
    }

    #{{ section_id }} .chb__image-wrap img {
      height: {{ section.settings.mobile_image_height }}px;
      object-fit: {{ section.settings.image_object_fit }};
    }

    #{{ section_id }} .chb__content {
      order: {{ section.settings.mobile_content_order }};
      text-align: {{ section.settings.mobile_text_align }};
    }

    #{{ section_id }} .chb__heading {
      font-size: {{ section.settings.mobile_heading_font_size }}px;
    }

    #{{ section_id }} .chb__subtext {
      font-size: {{ section.settings.mobile_subtext_font_size }}px;
      max-width: 100%;
    }

    #{{ section_id }} .chb__badges {
      justify-content: {{ section.settings.mobile_badges_align }};
      gap: 16px;
    }

    #{{ section_id }} .chb__badge {
      font-size: {{ section.settings.mobile_badge_font_size }}px;
    }
  }
</style>

<section id="{{ section_id }}" class="chb">
  <div class="chb__container">

    <!-- Content Left -->
    <div class="chb__content">

      {%- if section.settings.eyebrow != blank -%}
        <span class="chb__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="chb__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="chb__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="chb__badges">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' -%}
              <div class="chb__badge" {{ block.shopify_attributes }}>

                {%- if block.settings.badge_custom_icon != blank -%}
                  <span class="chb__badge-icon">
                    <img src="{{ block.settings.badge_custom_icon | image_url: width: 40 }}" alt="{{ block.settings.badge_label }}" loading="lazy" width="40" height="40">
                  </span>
                {%- elsif block.settings.badge_icon != 'none' -%}
                  <span class="chb__badge-icon">
                    {%- case block.settings.badge_icon -%}
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                      {%- when 'headphones' -%}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                          <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
                        </svg>
                      {%- when 'globe' -%}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <circle cx="12" cy="12" r="10"/>
                          <line x1="2" y1="12" x2="22" y2="12"/>
                          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                        </svg>
                      {%- when 'truck' -%}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <rect x="1" y="3" width="15" height="13"/>
                          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                          <circle cx="5.5" cy="18.5" r="2.5"/>
                          <circle cx="18.5" cy="18.5" r="2.5"/>
                        </svg>
                      {%- when 'check' -%}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <polyline points="20 6 9 17 4 12"/>
                        </svg>
                      {%- when 'star' -%}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                      {%- when 'mail' -%}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                          <polyline points="22,6 12,13 2,6"/>
                        </svg>
                      {%- when 'phone' -%}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.88a16 16 0 0 0 5.94 5.94l.9-.9a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                      {%- when 'lock' -%}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                      {%- when 'award' -%}
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <circle cx="12" cy="8" r="7"/>
                          <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                        </svg>
                    {%- endcase -%}
                  </span>
                {%- endif -%}

                {%- if block.settings.badge_label != blank -%}
                  <span>{{ block.settings.badge_label }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
    <!-- /Content Left -->

    <!-- Image Right -->
    {%- if section.settings.banner_image != blank -%}
      <div class="chb__image-wrap">
        <img
          src="{{ section.settings.banner_image | image_url: width: 800 }}"
          srcset="{{ section.settings.banner_image | image_url: width: 400 }} 400w,
                  {{ section.settings.banner_image | image_url: width: 600 }} 600w,
                  {{ section.settings.banner_image | image_url: width: 800 }} 800w"
          sizes="(max-width: 767px) 100vw, {{ section.settings.image_width }}px"
          alt="{{ section.settings.banner_image.alt | escape }}"
          width="{{ section.settings.image_width }}"
          height="{{ section.settings.image_height }}"
          loading="lazy"
        >
      </div>
    {%- endif -%}
    <!-- /Image Right -->

  </div>
</section>

{% schema %}
{
  "name": "Contact Help Banner",
  "tag": "section",
  "class": "contact-help-banner-section",
  "settings": [

    {
      "type": "header",
      "content": "🖼️ Layout & Container"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "label": "Section Max Width (px)",
      "min": 800,
      "max": 1920,
      "step": 20,
      "default": 1440
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ddeeff"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (overrides color if set)"
    },
    {
      "type": "select",
      "id": "bg_image_size",
      "label": "Background Image Size",
      "options": [
        { "value": "cover",   "label": "Cover (fill section)" },
        { "value": "contain", "label": "Contain (show full image)" },
        { "value": "auto",    "label": "Auto (original size)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "bg_image_position",
      "label": "Background Image Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center",    "label": "Top Center" },
        { "value": "bottom center", "label": "Bottom Center" },
        { "value": "left center",   "label": "Left Center" },
        { "value": "right center",  "label": "Right Center" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "bg_image_repeat",
      "label": "Background Image Repeat",
      "options": [
        { "value": "no-repeat", "label": "No Repeat" },
        { "value": "repeat",    "label": "Repeat" },
        { "value": "repeat-x",  "label": "Repeat Horizontal" },
        { "value": "repeat-y",  "label": "Repeat Vertical" }
      ],
      "default": "no-repeat"
    },

    {
      "type": "header",
      "content": "🌫️ Desktop Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Desktop Overlay Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Desktop Overlay Opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0
    },

    {
      "type": "header",
      "content": "🌫️ Mobile Overlay"
    },
    {
      "type": "color",
      "id": "mobile_overlay_color",
      "label": "Mobile Overlay Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "mobile_overlay_opacity",
      "label": "Mobile Overlay Opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50
    },

    {
      "type": "header",
      "content": "📐 Desktop Padding & Margin"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding Left & Right (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },

    {
      "type": "header",
      "content": "📐 Mobile Padding"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile Padding Top (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile Padding Bottom (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_horizontal",
      "label": "Mobile Padding Left & Right (px)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 20
    },

    {
      "type": "header",
      "content": "📝 Eyebrow Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CONTACT US"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#1a73e8"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "Eyebrow Font Size (px)",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 13
    },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "Eyebrow Font Weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "600"
    },

    {
      "type": "header",
      "content": "🔤 Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "We're Here To Help"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0d1b2a"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Heading Font Size – Desktop (px)",
      "min": 18,
      "max": 72,
      "step": 1,
      "default": 38
    },
    {
      "type": "range",
      "id": "tablet_heading_font_size",
      "label": "Heading Font Size – Tablet (px)",
      "min": 16,
      "max": 56,
      "step": 1,
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_heading_font_size",
      "label": "Heading Font Size – Mobile (px)",
      "min": 16,
      "max": 48,
      "step": 1,
      "default": 26
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Heading Font Weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra Bold (800)" },
        { "value": "900", "label": "Black (900)" }
      ],
      "default": "700"
    },

    {
      "type": "header",
      "content": "📄 Subtext / Description"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Have questions about Dr. Pen devices, cartridges, or your order? Our support team is ready to assist you."
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#4a5568"
    },
    {
      "type": "range",
      "id": "subtext_font_size",
      "label": "Subtext Font Size – Desktop (px)",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "tablet_subtext_font_size",
      "label": "Subtext Font Size – Tablet (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_subtext_font_size",
      "label": "Subtext Font Size – Mobile (px)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 14
    },
    {
      "type": "select",
      "id": "subtext_font_weight",
      "label": "Subtext Font Weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" }
      ],
      "default": "400"
    },

    {
      "type": "header",
      "content": "🏷️ Badge / Icon Strip Settings"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Badge Font Size – Desktop (px)",
      "min": 10,
      "max": 22,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_badge_font_size",
      "label": "Badge Font Size – Mobile (px)",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 13
    },
    {
      "type": "select",
      "id": "badge_font_weight",
      "label": "Badge Font Weight",
      "options": [
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#2d3748"
    },
    {
      "type": "color",
      "id": "badge_icon_color",
      "label": "Badge Icon Color",
      "default": "#1a73e8"
    },
    {
      "type": "range",
      "id": "badge_icon_size",
      "label": "Badge Icon Size (px)",
      "min": 16,
      "max": 48,
      "step": 2,
      "default": 22
    },

    {
      "type": "header",
      "content": "🖼️ Banner Image"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image Area Width – Desktop (px)",
      "min": 100,
      "max": 800,
      "step": 10,
      "default": 420
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image Height – Desktop (px)",
      "min": 80,
      "max": 600,
      "step": 10,
      "default": 220
    },
    {
      "type": "range",
      "id": "tablet_image_width",
      "label": "Image Area Width – Tablet (px)",
      "min": 80,
      "max": 500,
