{% comment %}
  Dr.pen Anti-Counterfeit Verification Section — v3 Redesign
  Drop into: sections/drpen-verification.liquid
{% endcomment %}

<style>
  #drpen-{{ section.id }} {
    --dp-max-width: {{ section.settings.max_width }}px;
    --dp-font-size: {{ section.settings.font_size }}px;
    --dp-font-weight: {{ section.settings.font_weight }};
    --dp-bg: {{ section.settings.bg_color }};
    --dp-title-color: {{ section.settings.title_color }};
    --dp-btn-bg: {{ section.settings.button_bg_color }};
    --dp-btn-color: {{ section.settings.button_text_color }};
    --dp-pt: {{ section.settings.padding_top }}px;
    --dp-pb: {{ section.settings.padding_bottom }}px;
    --dp-card-bg: {{ section.settings.card_bg }};
    --dp-card-header-bg: {{ section.settings.card_header_bg }};
    --dp-card-accent: #1e4a8a;
    --dp-card-width: {{ section.settings.card_width }}px;
    --dp-card-height: {{ section.settings.card_height }}px;
    --dp-card-radius: {{ section.settings.card_radius }}px;
    --dp-card-gap: {{ section.settings.card_gap }}px;
    --dp-qr-bg: {{ section.settings.qr_bg }};
    --dp-card-url-bg: {{ section.settings.card_url_bg }};
    --dp-card-url-color: {{ section.settings.card_url_color }};
    --dp-step-bg: {{ section.settings.step_bg }};
    --dp-step-color: {{ section.settings.step_color }};
  }

  #drpen-{{ section.id }} .dp-wrap {
    background: var(--dp-bg);
    padding: var(--dp-pt) 0 var(--dp-pb);
    font-family: {{ section.settings.font_family }}, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: var(--dp-font-size);
    font-weight: var(--dp-font-weight);
    {% if section.settings.bg_image != blank %}
      background-image: url('{{ section.settings.bg_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      position: relative;
    {% endif %}
  }

  {% if section.settings.bg_image != blank %}
  #drpen-{{ section.id }} .dp-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    background: {{ section.settings.bg_color }}d8;
    pointer-events: none;
  }
  {% endif %}

  #drpen-{{ section.id }} .dp-container {
    max-width: var(--dp-max-width);
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 1;
  }

  #drpen-{{ section.id }} .dp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
    min-height: {{ section.settings.min_height }}px;
  }

  #drpen-{{ section.id }} .dp-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 56px 56px 56px 0;
    border-right: 1.5px solid #dce6f0;
  }

  #drpen-{{ section.id }} .dp-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #e8f0fa;
    color: #1a3a6b;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: 18px;
    width: fit-content;
  }

  #drpen-{{ section.id }} .dp-badge svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: #1a3a6b;
    stroke-width: 2;
    flex-shrink: 0;
  }

  #drpen-{{ section.id }} .dp-title {
    font-size: clamp(20px, 2.4vw, 32px);
    font-weight: 700;
    color: var(--dp-title-color);
    line-height: 1.2;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  #drpen-{{ section.id }} .dp-subtitle {
    font-size: 14px;
    color: #6b7c93;
    line-height: 1.6;
    margin: 0 0 32px;
  }

  #drpen-{{ section.id }} .dp-input-group {
    display: flex;
    align-items: center;
    background: var(--dp-qr-bg);
    border: 1.5px solid #c8d8ea;
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.2s;
    margin-bottom: 14px;
  }

  #drpen-{{ section.id }} .dp-input-group:focus-within {
    border-color: #1a3a6b;
    box-shadow: 0 0 0 3px rgba(26,58,107,0.1);
  }

  #drpen-{{ section.id }} .dp-input-icon {
    padding: 0 0 0 16px;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  #drpen-{{ section.id }} .dp-input-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: #aab3c0;
    stroke-width: 1.8;
  }

  #drpen-{{ section.id }} .dp-input-group input[type="text"] {
    flex: 1;
    border: none;
    outline: none;
    padding: 14px 14px 14px 10px;
    font-size: 15px;
    font-family: inherit;
    background: transparent;
    color: #1a2a3a;
    letter-spacing: 0.03em;
    box-shadow: none;
    -webkit-appearance: none;
    appearance: none;
    min-width: 0;
  }

  #drpen-{{ section.id }} .dp-input-group input::placeholder {
    color: #b0bac8;
    letter-spacing: 0;
  }

  #drpen-{{ section.id }} .dp-verify-btn {
    background: var(--dp-btn-bg);
    color: var(--dp-btn-color);
    border: none;
    padding: 14px 20px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.2s, transform 0.1s;
    border-radius: 0 10px 10px 0;
    flex-shrink: 0;
    font-family: inherit;
  }

  #drpen-{{ section.id }} .dp-verify-btn:hover { background: #0f2548; }
  #drpen-{{ section.id }} .dp-verify-btn:active { transform: scale(0.98); }

  /* ── Inline result (shown below input) ── */
  #drpen-{{ section.id }} .dp-result {
    display: none;
    align-items: flex-start;
    gap: 10px;
    padding: 14px 16px;
    border-radius: 10px;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 6px;
    animation: dp-result-in 0.3s ease forwards;
  }

  @keyframes dp-result-in {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  #drpen-{{ section.id }} .dp-result.dp-success {
    background: linear-gradient(135deg, #e6f7ed 0%, #d0f0de 100%);
    color: #0d5c26;
    border: 1.5px solid #6ecb96;
    box-shadow: 0 4px 18px rgba(16, 120, 60, 0.13), 0 1px 4px rgba(16,120,60,0.08);
    display: flex;
    font-weight: 600;
  }

  #drpen-{{ section.id }} .dp-result.dp-error {
    background: #fef2f2;
    color: #911b1b;
    border: 1px solid #f5aaaa;
    display: flex;
  }

  #drpen-{{ section.id }} .dp-result svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 1px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  /* ── Success Popup Overlay ── */
  #dp-popup-{{ section.id }} {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99999;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(10, 22, 44, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: dp-overlay-in 0.25s ease forwards;
  }

  #dp-popup-{{ section.id }}.dp-popup-visible {
    display: flex;
  }

  @keyframes dp-overlay-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  #dp-popup-{{ section.id }} .dp-popup-card {
    background: #fff;
    border-radius: 24px;
    padding: 44px 40px 36px;
    max-width: 400px;
    width: 100%;
    text-align: center;
    box-shadow:
      0 32px 80px rgba(13,33,64,0.28),
      0 8px 24px rgba(13,33,64,0.14);
    animation: dp-popup-in 0.35s cubic-bezier(0.34,1.56,0.64,1) forwards;
    position: relative;
    overflow: hidden;
  }

  #dp-popup-{{ section.id }} .dp-popup-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 5px;
    background: linear-gradient(90deg, #22c55e, #16a34a, #4ade80);
    border-radius: 24px 24px 0 0;
  }

  @keyframes dp-popup-in {
    from { opacity: 0; transform: scale(0.82) translateY(24px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  #dp-popup-{{ section.id }} .dp-popup-icon-wrap {
    width: 72px;
    height: 72px;
    background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    position: relative;
  }

  #dp-popup-{{ section.id }} .dp-popup-icon-wrap::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid rgba(34,197,94,0.25);
    animation: dp-ring-pulse 1.8s ease-out infinite;
  }

  @keyframes dp-ring-pulse {
    0%   { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(1.35); opacity: 0; }
  }

  #dp-popup-{{ section.id }} .dp-popup-icon-wrap svg {
    width: 36px;
    height: 36px;
    fill: none;
    stroke: #16a34a;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: dp-check-draw 0.5s ease 0.15s both;
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
  }

  @keyframes dp-check-draw {
    to { stroke-dashoffset: 0; }
  }

  #dp-popup-{{ section.id }} .dp-popup-title {
    font-size: 22px;
    font-weight: 800;
    color: #0d5c26;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
    font-family: inherit;
  }

  #dp-popup-{{ section.id }} .dp-popup-msg {
    font-size: 14px;
    color: #4b6a55;
    line-height: 1.65;
    margin: 0 0 8px;
    font-family: inherit;
  }

  #dp-popup-{{ section.id }} .dp-popup-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #15803d;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
    margin-top: 10px;
  }

  #dp-popup-{{ section.id }} .dp-popup-badge svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: #15803d;
    stroke-width: 2.5;
  }

  #dp-popup-{{ section.id }} .dp-popup-progress {
    position: absolute;
    bottom: 0; left: 0;
    height: 3px;
    background: linear-gradient(90deg, #22c55e, #4ade80);
    border-radius: 0 0 24px 24px;
    width: 100%;
    transform-origin: left;
    animation: dp-progress-bar var(--dp-popup-duration, 2.5s) linear forwards;
  }

  @keyframes dp-progress-bar {
    from { transform: scaleX(1); }
    to   { transform: scaleX(0); }
  }

  /* ── Trust row ── */
  #drpen-{{ section.id }} .dp-trust-row {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid #e4eaf2;
    flex-wrap: wrap;
  }

  #drpen-{{ section.id }} .dp-trust-item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: #7a8fa6;
  }

  #drpen-{{ section.id }} .dp-trust-item svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: #5a9a6a;
    stroke-width: 2;
    flex-shrink: 0;
  }

  #drpen-{{ section.id }} .dp-right {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 56px 0 56px 48px;
  }

  #drpen-{{ section.id }} .dp-cards-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: var(--dp-card-gap);
    flex-wrap: wrap;
    justify-content: center;
  }

  #drpen-{{ section.id }} .dp-card-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: var(--dp-card-width);
    max-width: 100%;
  }

  #drpen-{{ section.id }} .dp-card {
    background: var(--dp-card-bg);
    border-radius: var(--dp-card-radius);
    width: 100%;
    min-height: var(--dp-card-height);
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
  }

  #drpen-{{ section.id }} .dp-card-col:first-child .dp-card {
    box-shadow: 0 4px 12px rgba(13,33,64,0.15), 0 1px 4px rgba(13,33,64,0.08);
  }

  #drpen-{{ section.id }} .dp-card-col:last-child .dp-card {
    box-shadow:
      0 20px 48px rgba(13,33,64,0.32),
      0 8px 20px rgba(13,33,64,0.18),
      0 2px 6px rgba(13,33,64,0.12),
      inset 0 1px 0 rgba(255,255,255,0.07);
    transform: translateY(-6px);
    border: 1px solid rgba(255,255,255,0.06);
  }

  #drpen-{{ section.id }} .dp-card-header {
    background: var(--dp-card-header-bg);
    padding: 10px 12px 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  #drpen-{{ section.id }} .dp-card-header-text {
    font-size: clamp(9px, 0.9vw, 13px);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
    text-align: center;
    line-height: 1.3;
  }

  #drpen-{{ section.id }} .dp-card-header svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: #f0c040;
    stroke-width: 2;
    flex-shrink: 0;
  }

  #drpen-{{ section.id }} .dp-card-body { padding: 10px 14px 0; }

  #drpen-{{ section.id }} .dp-card-inst {
    font-size: 9px;
    color: #a8c0dc;
    text-align: center;
    line-height: 1.5;
    margin-bottom: 8px;
  }

  #drpen-{{ section.id }} .dp-card-qr {
    background: var(--dp-qr-bg);
    border-radius: 8px;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #drpen-{{ section.id }} .dp-card-qr img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
    object-fit: contain;
  }

  #drpen-{{ section.id }} .dp-card-qr svg {
    width: 65%;
    height: auto;
    display: block;
  }

  #drpen-{{ section.id }} .dp-scratch-bar {
    background: #7a94b0;
    text-align: center;
    font-size: 8.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 7px 6px;
    color: #0e2140;
    margin-top: 10px;
  }

  #drpen-{{ section.id }} .dp-card-code-revealed {
    background: #1a3f75;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #d8eaff;
    text-align: center;
    padding: 8px;
    margin-top: 10px;
  }

  #drpen-{{ section.id }} .dp-card-footer { padding: 8px 14px 14px; }

  #drpen-{{ section.id }} .dp-card-url {
    width: 100%;
    box-sizing: border-box;
    background: var(--dp-card-url-bg);
    color: var(--dp-card-url-color);
    text-align: center;
    font-size: 10px;
    font-weight: 700;
    padding: 5px;
    border-radius: 6px;
    margin-bottom: 10px;
  }

  #drpen-{{ section.id }} .dp-card-brand {
    text-align: center;
    font-style: italic;
    font-size: 15px;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.01em;
  }

  #drpen-{{ section.id }} .dp-card-tagline {
    font-style: normal;
    font-size: 9px;
    font-weight: 400;
    color: #7a9cc0;
    letter-spacing: 0.06em;
    display: block;
    text-align: center;
    margin-top: 2px;
    padding-bottom: 2px;
  }

  #drpen-{{ section.id }} .dp-card-label {
    text-align: center;
    width: 100%;
  }

  #drpen-{{ section.id }} .dp-info-step {
    width: 24px;
    height: 24px;
    background: var(--dp-step-bg);
    color: var(--dp-step-color);
    font-size: 12px;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 8px;
  }

  #drpen-{{ section.id }} .dp-info-text {
    font-size: 13px;
    color: #5a6e82;
    line-height: 1.65;
    text-align: center;
  }

  #drpen-{{ section.id }} .dp-info-text strong {
    color: #1a2a3a;
    font-weight: 600;
  }

  #drpen-{{ section.id }} .dp-cards-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 80px;
    flex-shrink: 0;
    color: #a0b4cc;
  }

  #drpen-{{ section.id }} .dp-cards-arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  /* ── Laptop (701px – 1200px): slider in the right column ── */
  @media (min-width: 701px) and (max-width: 1200px) {
    #drpen-{{ section.id }} .dp-container { padding: 0 28px; }

    #drpen-{{ section.id }} .dp-grid {
      grid-template-columns: 1fr 1fr;
      min-height: unset;
    }

    #drpen-{{ section.id }} .dp-left {
      padding: 40px 32px 40px 0;
    }

    #drpen-{{ section.id }} .dp-right {
      padding: 32px 0 32px 24px;
      align-items: center;
      justify-content: center;
      flex-direction: column;
    }

    /* Slider wrapper replaces the free-flow row */
    #drpen-{{ section.id }} .dp-cards-row {
      display: block;           /* slider takes over layout */
      width: 100%;
      position: relative;
    }

    /* Viewport / clip window */
    #drpen-{{ section.id }} .dp-slider-viewport {
      overflow: hidden;
      width: 100%;
      border-radius: 4px;
    }

    /* Track that slides */
    #drpen-{{ section.id }} .dp-slider-track {
      display: flex;
      flex-direction: row;
      transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: transform;
    }

    /* Each slide = one card-col */
    #drpen-{{ section.id }} .dp-slider-track .dp-card-col {
      flex: 0 0 100%;
      width: 100%;
      max-width: 100%;
      padding: 0 8px;
      box-sizing: border-box;
      align-items: center;
    }

    /* Card itself: constrain width nicely */
    #drpen-{{ section.id }} .dp-slider-track .dp-card {
      min-height: unset;
      width: clamp(160px, 80%, 240px);
      margin: 0 auto;
    }

    /* Hide the static arrow — slider nav replaces it */
    #drpen-{{ section.id }} .dp-cards-arrow { display: none; }

    /* Slider nav row: prev · dots · next */
    #drpen-{{ section.id }} .dp-slider-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      margin-top: 18px;
    }

    #drpen-{{ section.id }} .dp-slider-btn {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1.5px solid #c8d8ea;
      background: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.18s, border-color 0.18s;
      flex-shrink: 0;
    }

    #drpen-{{ section.id }} .dp-slider-btn:hover {
      background: #e8f0fa;
      border-color: #1a3a6b;
    }

    #drpen-{{ section.id }} .dp-slider-btn svg {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: #1a3a6b;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    #drpen-{{ section.id }} .dp-slider-dots {
      display: flex;
      gap: 7px;
      align-items: center;
    }

    #drpen-{{ section.id }} .dp-slider-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #c8d8ea;
      transition: background 0.2s, transform 0.2s;
      cursor: pointer;
    }

    #drpen-{{ section.id }} .dp-slider-dot.dp-dot-active {
      background: #1a3a6b;
      transform: scale(1.25);
    }

    /* Step label below each slide */
    #drpen-{{ section.id }} .dp-slider-track .dp-card-label {
      margin-top: 14px;
    }

    #drpen-{{ section.id }} .dp-title { font-size: clamp(17px, 2vw, 26px); }
    #drpen-{{ section.id }} .dp-subtitle { font-size: 13px; margin-bottom: 20px; }
    #drpen-{{ section.id }} .dp-trust-row { gap: 12px; margin-top: 20px; padding-top: 18px; }
    #drpen-{{ section.id }} .dp-trust-item { font-size: 11px; }
    #drpen-{{ section.id }} .dp-card-header-text { font-size: clamp(7px, 0.9vw, 11px); }
    #drpen-{{ section.id }} .dp-info-text { font-size: 11px; }
    #drpen-{{ section.id }} .dp-card-brand { font-size: 12px; }
    #drpen-{{ section.id }} .dp-verify-btn { padding: 14px 14px; font-size: 11px; letter-spacing: 0.06em; }
    #drpen-{{ section.id }} .dp-input-group input[type="text"] { font-size: 14px; }
    #drpen-{{ section.id }} .dp-badge { font-size: 10px; margin-bottom: 14px; }
  }

  /* ── Narrow laptop (701px – 960px): tighter padding only ── */
  @media (min-width: 701px) and (max-width: 960px) {
    #drpen-{{ section.id }} .dp-container { padding: 0 20px; }
    #drpen-{{ section.id }} .dp-left { padding: 32px 20px 32px 0; }
    #drpen-{{ section.id }} .dp-right { padding: 28px 0 28px 16px; }
    #drpen-{{ section.id }} .dp-verify-btn { padding: 14px 10px; font-size: 10px; }
  }

  /* ── Mobile ── */
  @media (max-width: 700px) {
    #drpen-{{ section.id }} .dp-container { padding: 0 {{ section.settings.mobile_padding }}px; }
    #drpen-{{ section.id }} .dp-grid { grid-template-columns: 1fr; min-height: unset; }
    #drpen-{{ section.id }} .dp-left {
      padding: {{ section.settings.mobile_padding }}px 0 28px 0;
      border-right: none;
      border-bottom: 1.5px solid #dce6f0;
    }
    #drpen-{{ section.id }} .dp-right {
      padding: 28px 0 {{ section.settings.mobile_padding }}px 0;
      justify-content: center;
    }
    #drpen-{{ section.id }} .dp-title { font-size: {{ section.settings.mobile_font_size | times: 1.4 | round }}px; }
    #drpen-{{ section.id }} .dp-subtitle {
      font-size: {{ section.settings.mobile_font_size | minus: 2 }}px;
      margin-bottom: 20px;
    }
    #drpen-{{ section.id }} .dp-trust-row { gap: 10px; margin-top: 20px; padding-top: 16px; }
    #drpen-{{ section.id }} .dp-trust-item { font-size: 11px; }
    #drpen-{{ section.id }} .dp-badge { font-size: 10px; margin-bottom: 12px; }
    #drpen-{{ section.id }} .dp-cards-row {
