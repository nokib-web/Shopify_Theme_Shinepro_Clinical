<script>
(function() {
  var sid = '{{ section.id }}';
  var POPUP_DURATION = 2800; // ms

  /* ── Laptop Slider (701px–1200px) ── */
  function initSlider() {
    var LAPTOP_MIN = 701, LAPTOP_MAX = 1200;
    var row        = document.querySelector('#drpen-' + sid + ' .dp-cards-row');
    if (!row) return;

    var slides     = Array.prototype.slice.call(row.querySelectorAll('.dp-card-col'));
    if (slides.length < 2) return;

    var current    = 0;
    var viewport   = null;
    var track      = null;
    var dotsEl     = null;
    var prevBtn    = null;
    var nextBtn    = null;
    var navEl      = null;
    var sliderActive = false;

    function buildSlider() {
      if (sliderActive) return;
      sliderActive = true;

      /* Hide the static arrow */
      var arrow = row.querySelector('.dp-cards-arrow');
      if (arrow) arrow.style.display = 'none';

      /* Wrap row contents in viewport > track */
      viewport = document.createElement('div');
      viewport.className = 'dp-slider-viewport';
      track = document.createElement('div');
      track.className = 'dp-slider-track';

      /* Move slides into track */
      slides.forEach(function(s) { track.appendChild(s); });
      viewport.appendChild(track);
      row.insertBefore(viewport, row.firstChild);

      /* Build nav: prev · dots · next */
      navEl = document.createElement('div');
      navEl.className = 'dp-slider-nav';

      prevBtn = document.createElement('button');
      prevBtn.className = 'dp-slider-btn';
      prevBtn.setAttribute('aria-label', 'Previous card');
      prevBtn.innerHTML = '<svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>';

      dotsEl = document.createElement('div');
      dotsEl.className = 'dp-slider-dots';
      slides.forEach(function(_, i) {
        var dot = document.createElement('span');
        dot.className = 'dp-slider-dot' + (i === 0 ? ' dp-dot-active' : '');
        dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        dot.addEventListener('click', function() { goTo(i); });
        dotsEl.appendChild(dot);
      });

      nextBtn = document.createElement('button');
      nextBtn.className = 'dp-slider-btn';
      nextBtn.setAttribute('aria-label', 'Next card');
      nextBtn.innerHTML = '<svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>';

      navEl.appendChild(prevBtn);
      navEl.appendChild(dotsEl);
      navEl.appendChild(nextBtn);
      row.appendChild(navEl);

      prevBtn.addEventListener('click', function() { goTo(current - 1); });
      nextBtn.addEventListener('click', function() { goTo(current + 1); });

      goTo(0);
    }

    function teardownSlider() {
      if (!sliderActive) return;
      sliderActive = false;

      /* Move slides back into row directly */
      var arrow = row.querySelector('.dp-cards-arrow');
      slides.forEach(function(s) { row.appendChild(s); });
      if (arrow) { row.appendChild(arrow); arrow.style.display = ''; }
      if (viewport && viewport.parentNode) viewport.parentNode.removeChild(viewport);
      if (navEl && navEl.parentNode) navEl.parentNode.removeChild(navEl);
      viewport = track = dotsEl = prevBtn = nextBtn = navEl = null;
      current = 0;
    }

    function goTo(idx) {
      var total = slides.length;
      current = (idx + total) % total;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      var dots = dotsEl.querySelectorAll('.dp-slider-dot');
      dots.forEach(function(d, i) {
        d.classList.toggle('dp-dot-active', i === current);
      });
    }

    function check() {
      var w = window.innerWidth;
      var shouldBeSlider = w >= LAPTOP_MIN && w <= LAPTOP_MAX;
      if (shouldBeSlider && !sliderActive) buildSlider();
      else if (!shouldBeSlider && sliderActive) teardownSlider();
    }

    check();
    window.addEventListener('resize', check);
  }

  /* Run slider init after DOM is ready */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSlider);
  } else {
    initSlider();
  }

  var validCodes = '{{ section.settings.valid_codes }}'
    .split(',')
    .map(function(c){ return c.trim().toUpperCase(); })
    .filter(function(c){ return c.length > 0; });

  var successMsg = {{ section.settings.success_message | json }};
  var errorMsg   = {{ section.settings.error_message | json }};

  var input    = document.getElementById('dp-input-' + sid);
  var btn      = document.getElementById('dp-btn-' + sid);
  var box      = document.getElementById('dp-result-' + sid);
  var icon     = document.getElementById('dp-ricon-' + sid);
  var text     = document.getElementById('dp-rtext-' + sid);
  var popup    = document.getElementById('dp-popup-' + sid);
  var popupMsg = document.getElementById('dp-popup-msg-' + sid);
  var popupProg= document.getElementById('dp-popup-prog-' + sid);

  var ICON_OK  = '<circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14.2 15 10"/>';
  var ICON_ERR = '<circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>';

  var popupTimer = null;

  function showPopup(msg) {
    popupMsg.textContent = msg;
    popupProg.style.animation = 'none';
    popupProg.style.setProperty('--dp-popup-duration', (POPUP_DURATION / 1000) + 's');
    popup.classList.add('dp-popup-visible');
    void popupProg.offsetWidth;
    popupProg.style.animation = 'dp-progress-bar ' + (POPUP_DURATION / 1000) + 's linear forwards';

    if (popupTimer) clearTimeout(popupTimer);
    popupTimer = setTimeout(function() {
      popup.classList.remove('dp-popup-visible');
    }, POPUP_DURATION);
  }

  popup.addEventListener('click', function(e) {
    if (e.target === popup) {
      popup.classList.remove('dp-popup-visible');
      if (popupTimer) clearTimeout(popupTimer);
    }
  });

  function verify() {
    var val = input.value.trim().toUpperCase();
    if (!val) { input.focus(); return; }

    box.className = 'dp-result';
    box.style.display = 'none';

    if (validCodes.indexOf(val) !== -1) {
      showPopup(successMsg);
      box.classList.add('dp-success');
      icon.innerHTML = ICON_OK;
      text.textContent = successMsg;
      box.style.display = 'flex';
    } else {
      box.classList.add('dp-error');
      icon.innerHTML = ICON_ERR;
      text.textContent = errorMsg;
      box.style.display = 'flex';
      box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  btn.addEventListener('click', verify);
  input.addEventListener('keydown', function(e){ if (e.key === 'Enter') verify(); });
  input.addEventListener('input', function(){
    if (box.style.display !== 'none') {
      box.style.display = 'none';
      box.className = 'dp-result';
    }
  });
})();
</script>

