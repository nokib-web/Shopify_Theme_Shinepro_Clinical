
{% comment %}
  ============================================================
  VIDEO HERO BANNER SECTION — Shopify Liquid
  Full responsive, autoplay video background
  Overlay affects ONLY the video layer — text is fully above it
  ============================================================
{% endcomment %}

{% if section.settings.font_family.family and section.settings.font_family.family != '' %}
  {{ section.settings.font_family | font_face: font_display: 'swap' }}
{% endif %}

{% assign op_desk   = section.settings.overlay_opacity        | times: 1 %}
{% assign op_tablet = section.settings.overlay_opacity_tablet | times: 1 %}
{% assign op_mobile = section.settings.overlay_opacity_mobile | times: 1 %}

<style>
  /* ── Wrapper ── */
  #banner-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.section_height }}px;
    min-height: {{ section.settings.section_min_height }}px;
    overflow: hidden;
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
    justify-content: {{ section.settings.horizontal_alignment }};
    background: #000;
  }

  /* ── MEDIA LAYER: video + overlay together, z-index 0 ── */
  #banner-{{ section.id }} .banner__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
  }

  #banner-{{ section.id }} .banner__media video,
  #banner-{{ section.id }} .banner__media .banner__shopify-video,
  #banner-{{ section.id }} .banner__media .banner__shopify-video video {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    object-position: {{ section.settings.video_position }};
    display: block;
  }

  #banner-{{ section.id }} .banner__fallback-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.video_position }};
    display: none;
  }

  {% if section.settings.hide_video_mobile %}
  @media (max-width: 767px) {
    #banner-{{ section.id }} .banner__media video,
    #banner-{{ section.id }} .banner__media .banner__shopify-video { display: none; }
    #banner-{{ section.id }} .banner__fallback-img { display: block !important; }
  }
  {% endif %}

  /* ── OVERLAY: lives INSIDE .banner__media, dims video only ── */
  /* Because it's inside the media div, it can never affect text above */
  #banner-{{ section.id }} .banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ op_desk | divided_by: 100.0 }};
    pointer-events: none;
    display: block;
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    #banner-{{ section.id }} .banner__overlay {
      opacity: {{ op_tablet | divided_by: 100.0 }};
    }
  }

  @media (max-width: 767px) {
    #banner-{{ section.id }} .banner__overlay {
      opacity: {{ op_mobile | divided_by: 100.0 }};
    }
  }

  /* ── CONTENT: z-index 1 — completely above the media+overlay stack ── */
  #banner-{{ section.id }} .banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    {%- if section.settings.font_family.family and section.settings.font_family.family != '' -%}
      font-family: {{ section.settings.font_family.family }}, {{ section.settings.font_family.fallback_families }};
    {%- endif -%}
    align-items: {%- if section.settings.text_align == 'center' -%}center{%- elsif section.settings.text_align == 'right' -%}flex-end{%- else -%}flex-start{%- endif -%};
    text-align: {{ section.settings.text_align }};
    width: 100%;
    max-width: {{ section.settings.content_max_width }}px;
    padding-top:    {{ section.settings.content_padding_top }}px;
    padding-bottom: {{ section.settings.content_padding_bottom }}px;
    padding-left:   {{ section.settings.content_padding_left }}px;
    padding-right:  {{ section.settings.content_padding_right }}px;
  }

  /* ── Subheading ── */
  #banner-{{ section.id }} .banner__subheading {
    display: block;
    color: {{ section.settings.subheading_color }};
    text-shadow: 0 1px 4px rgba(0,0,0,0.35), 0 2px 10px rgba(0,0,0,0.25);
    font-size: {{ section.settings.subheading_size }}px;
    font-weight: {{ section.settings.subheading_weight }};
    letter-spacing: {{ section.settings.subheading_letter_spacing }}em;
    text-transform: {{ section.settings.subheading_transform }};
    margin-top:    {{ section.settings.subheading_margin_top }}px;
    margin-bottom: {{ section.settings.subheading_margin_bottom }}px;
    line-height: 1.4;
  }

  /* ── Heading ── */
  #banner-{{ section.id }} .banner__heading {
    color: {{ section.settings.heading_color }};
    text-shadow: 0 2px 4px rgba(0,0,0,0.35), 0 4px 14px rgba(0,0,0,0.25);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}em;
    text-transform: {{ section.settings.heading_transform }};
    margin-top:    {{ section.settings.heading_margin_top }}px;
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
  }

  #banner-{{ section.id }} .banner__heading em,
  #banner-{{ section.id }} .banner__heading i { font-style: italic; }

  /* ── Description ── */
  #banner-{{ section.id }} .banner__description {
    color: {{ section.settings.description_color }};
    text-shadow: 0 1px 4px rgba(0,0,0,0.35), 0 2px 10px rgba(0,0,0,0.25);
    font-size: {{ section.settings.description_size }}px;
    font-weight: {{ section.settings.description_weight }};
    line-height: {{ section.settings.description_line_height }};
    max-width: {{ section.settings.description_max_width }}px;
    margin-top:    {{ section.settings.description_margin_top }}px;
    margin-bottom: {{ section.settings.description_margin_bottom }}px;
    {% if section.settings.text_align == 'center' %}margin-left: auto; margin-right: auto;
    {% elsif section.settings.text_align == 'right' %}margin-left: auto; margin-right: 0;
    {% else %}margin-left: 0; margin-right: auto;{% endif %}
  }

  /* ── Button ── */
  #banner-{{ section.id }} .banner__btn-wrap {
    margin-top:    {{ section.settings.button_margin_top }}px;
    margin-bottom: {{ section.settings.button_margin_bottom }}px;
  }

  #banner-{{ section.id }} .banner__btn {
    display: inline-block;
    text-decoration: none;
    cursor: pointer;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    letter-spacing: {{ section.settings.button_letter_spacing }}em;
    text-transform: {{ section.settings.button_text_transform }};
    border-radius: {{ section.settings.button_border_radius }}px;
    border-width: {{ section.settings.button_border_width }}px;
    border-style: solid;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    {% if section.settings.button_style == 'filled' %}
      background-color: {{ section.settings.button_bg_color }};
      color: {{ section.settings.button_text_color }};
      border-color: {{ section.settings.button_bg_color }};
    {% elsif section.settings.button_style == 'outline' %}
      background-color: transparent;
      color: {{ section.settings.button_text_color }};
      border-color: {{ section.settings.button_border_color }};
    {% else %}
      background-color: transparent;
      color: {{ section.settings.button_text_color }};
      border-color: transparent;
    {% endif %}
  }

  #banner-{{ section.id }} .banner__btn:hover {
    background-color: {{ section.settings.button_hover_bg }};
    color: {{ section.settings.button_hover_text }};
    border-color: {{ section.settings.button_hover_bg }};
  }

  /* ── Responsive: Tablet ── */
  @media (min-width: 768px) and (max-width: 1024px) {
    #banner-{{ section.id }} {
      height: {{ section.settings.section_height_tablet }}px;
      min-height: {{ section.settings.section_min_height }}px;
    }
    #banner-{{ section.id }} .banner__heading     { font-size: {{ section.settings.heading_size_tablet }}px; }
    #banner-{{ section.id }} .banner__description { font-size: {{ section.settings.description_size_tablet }}px; }
    #banner-{{ section.id }} .banner__subheading  { font-size: {{ section.settings.subheading_size_tablet }}px; }
  }

  /* ── Responsive: Mobile ── */
  @media (max-width: 767px) {
    #banner-{{ section.id }} {
      height: {{ section.settings.section_height_mobile }}px;
      min-height: {{ section.settings.section_min_height_mobile }}px;
    }
    #banner-{{ section.id }} .banner__heading     { font-size: {{ section.settings.heading_size_mobile }}px; }
    #banner-{{ section.id }} .banner__description { font-size: {{ section.settings.description_size_mobile }}px; }
    #banner-{{ section.id }} .banner__subheading  { font-size: {{ section.settings.subheading_size_mobile }}px; }
    #banner-{{ section.id }} .banner__content {
      padding-left:   {{ section.settings.content_padding_left_mobile }}px;
      padding-right:  {{ section.settings.content_padding_right_mobile }}px;
      padding-top:    {{ section.settings.content_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.content_padding_bottom_mobile }}px;
    }
  }
</style>

<section id="banner-{{ section.id }}" class="banner-section">

  <!-- ── MEDIA LAYER: video + overlay dimmer together ── -->
  <div class="banner__media">

    {% if section.settings.video_url != blank %}
      <video
        autoplay muted loop playsinline
        {% if section.settings.video_show_controls %}controls{% endif %}
        preload="auto"
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
        {% if section.settings.video_url_webm != blank %}
          <source src="{{ section.settings.video_url_webm }}" type="video/webm">
        {% endif %}
        {% if section.settings.video_url_ogg != blank %}
          <source src="{{ section.settings.video_url_ogg }}" type="video/ogg">
        {% endif %}
      </video>
    {% elsif section.settings.shopify_video != blank %}
      <div class="banner__shopify-video">
        {{- section.settings.shopify_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true -}}
      </div>
    {% endif %}

    {% if section.settings.fallback_image != blank %}
      {{
        section.settings.fallback_image
        | image_url: width: 1920
        | image_tag:
          class: 'banner__fallback-img',
          loading: 'eager',
          alt: section.settings.fallback_image.alt | escape
      }}
    {% endif %}

    <!-- Overlay lives HERE, inside media — so it dims video only, never text -->
    <div class="banner__overlay" aria-hidden="true"></div>

  </div>

  <!-- ── CONTENT: rendered after media in DOM, z-index:1, fully above overlay ── -->
  <div class="banner__content">

    {% if section.settings.heading != blank %}
      <{{ section.settings.heading_tag }} class="banner__heading">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <span class="banner__subheading">{{ section.settings.subheading }}</span>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="banner__description">{{ section.settings.description }}</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <div class="banner__btn-wrap">
        <a
          href="{{ section.settings.button_link }}"
          class="banner__btn"
          {% if section.settings.button_open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

<script>
  /* JS runtime: set overlay opacity responsively, scoped to video inside media */
  (function() {
    var banner = document.getElementById('banner-{{ section.id }}');
    if (!banner) return;
    var overlay = banner.querySelector('.banner__media .banner__overlay');
    if (!overlay) return;

    function applyOverlay() {
      var w = window.innerWidth;
      var op;
      if (w <= 767) {
        op = {{ section.settings.overlay_opacity_mobile }} / 100;
      } else if (w <= 1024) {
        op = {{ section.settings.overlay_opacity_tablet }} / 100;
      } else {
        op = {{ section.settings.overlay_opacity }} / 100;
      }
      overlay.style.setProperty('background-color', '{{ section.settings.overlay_color }}', 'important');
      overlay.style.setProperty('opacity', op, 'important');
      overlay.style.setProperty('position', 'absolute', 'important');
      overlay.style.setProperty('inset', '0', 'important');
      overlay.style.setProperty('z-index', '2', 'important');
      overlay.style.setProperty('pointer-events', 'none', 'important');
    }

    applyOverlay();
    window.addEventListener('resize', applyOverlay);
  })();
</script>


{% schema %}
{
  "name": "Video Hero Banner",
  "tag": "section",
  "class": "section-video-banner",
  "settings": [
    { "type": "header", "content": "🔤 Font Family" },
    { "type": "font_picker", "id": "font_family", "label": "Font Family (leave unchanged to use theme default)", "default": "helvetica_n4" },

    { "type": "header", "content": "🎬 Video Settings" },
    { "type": "video",  "id": "shopify_video", "label": "Video (Shopify Hosted)", "info": "Upload via Shopify Files." },
    { "type": "text",   "id": "video_url",      "label": "External Video URL (MP4)",  "placeholder": "https://yourcdn.com/video.mp4" },
    { "type": "text",   "id": "video_url_webm", "label": "External Video URL (WebM)", "placeholder": "https://yourcdn.com/video.webm", "info": "Optional: WebM for better browser support" },
    { "type": "text",   "id": "video_url_ogg",  "label": "External Video URL (OGG)",  "placeholder": "https://yourcdn.com/video.ogv",  "info": "Optional: OGG fallback" },
    { "type": "image_picker", "id": "fallback_image", "label": "Fallback / Poster Image", "info": "Shown when video cannot play" },
    {
      "type": "select", "id": "video_position", "label": "Video Focus / Position", "default": "center center",
      "options": [
        { "value": "center center", "label": "Center Center" },
        { "value": "center top",    "label": "Center Top"    },
        { "value": "center bottom", "label": "Center Bottom" },
        { "value": "left center",   "label": "Left Center"   },
        { "value": "right center",  "label": "Right Center"  }
      ]
    },
    { "type": "checkbox", "id": "hide_video_mobile",   "label": "Hide video on Mobile (show image instead)", "default": false },
    { "type": "checkbox", "id": "video_show_controls", "label": "Show Video Controls",                       "default": false },

    { "type": "header", "content": "🖼️ Overlay Settings" },
    { "type": "color", "id": "overlay_color", "label": "Overlay Color", "default": "#000000", "info": "Overlay dims the video only — text is never affected" },
    { "type": "range", "id": "overlay_opacity",        "label": "Overlay Opacity — Desktop (%)", "min": 0, "max": 100, "step": 5, "default": 35 },
    { "type": "range", "id": "overlay_opacity_tablet", "label": "Overlay Opacity — Tablet (%)",  "min": 0, "max": 100, "step": 5, "default": 45 },
    { "type": "range", "id": "overlay_opacity_mobile", "label": "Overlay Opacity — Mobile (%)",  "min": 0, "max": 100, "step": 5, "default": 55 },

    { "type": "header", "content": "📐 Section Size & Layout" },
    { "type": "range", "id": "section_height",            "label": "Section Height — Desktop (px)", "min": 200, "max": 1200, "step": 10, "default": 600 },
    { "type": "range", "id": "section_height_tablet",     "label": "Section Height — Tablet (px)",  "min": 200, "max": 900,  "step": 10, "default": 500 },
    { "type": "range", "id": "section_height_mobile",     "label": "Section Height — Mobile (px)",  "min": 200, "max": 800,  "step": 10, "default": 400 },
    { "type": "range", "id": "section_min_height",        "label": "Min Height — Desktop/Tablet (px)", "min": 100, "max": 600, "step": 10, "default": 300 },
    { "type": "range", "id": "section_min_height_mobile", "label": "Min Height — Mobile (px)",      "min": 100, "max": 600, "step": 10, "default": 250 },
    {
      "type": "select", "id": "vertical_alignment", "label": "Vertical Alignment", "default": "center",
      "options": [
        { "value": "flex-start", "label": "Top"    },
        { "value": "center",     "label": "Middle" },
        { "value": "flex-end",   "label": "Bottom" }
      ]
    },
    {
