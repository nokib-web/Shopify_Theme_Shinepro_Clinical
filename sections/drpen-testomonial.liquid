{% comment %}
  ============================================================
  Section: Dr. Pen - Testimonials / Happy Customers Section
  Features:
    - Label, Heading, Subheading
    - Testimonial cards: quote, avatar image, name, role
    - Max-width, padding, margin, font-size, color, font-weight controls
    - Separate Desktop, Tablet & Mobile customization
    - Icon support (star rating / custom emoji / SVG)
    - Fully responsive grid
    - Font family inherited from global theme
  ============================================================
{% endcomment %}

{%- liquid
  assign section_id = 'drpen-testimonials-' | append: section.id
-%}

<style>
  #{{ section_id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    padding-left: {{ section.settings.desktop_padding_lr }}px;
    padding-right: {{ section.settings.desktop_padding_lr }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    font-family: inherit;
  }

  #{{ section_id }} .drpen-t-inner {
    max-width: {{ section.settings.max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ---- Label ---- */
  #{{ section_id }} .drpen-t-label {
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.header_align }};
    gap: 12px;
    margin-bottom: {{ section.settings.label_margin_bottom }}px;
  }

  #{{ section_id }} .drpen-t-label-line {
    display: inline-block;
    width: {{ section.settings.label_line_width }}px;
    height: 2px;
    background-color: {{ section.settings.label_color }};
  }

  #{{ section_id }} .drpen-t-label-text {
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.label_size }}px;
    font-weight: {{ section.settings.label_weight }};
    letter-spacing: {{ section.settings.label_letter_spacing }}em;
    text-transform: uppercase;
    font-family: inherit;
  }

  /* ---- Heading ---- */
  #{{ section_id }} .drpen-t-heading {
    text-align: {{ section.settings.header_align }};
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.desktop_heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.2;
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
    font-family: inherit;
  }

  /* ---- Subheading ---- */
  #{{ section_id }} .drpen-t-subheading {
    text-align: {{ section.settings.header_align }};
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.desktop_subheading_size }}px;
    font-weight: {{ section.settings.subheading_weight }};
    line-height: 1.7;
    margin: 0 auto {{ section.settings.subheading_margin_bottom }}px auto;
    max-width: {{ section.settings.subheading_max_width }}px;
    font-family: inherit;
  }

  /* ---- Grid ---- */
  #{{ section_id }} .drpen-t-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: {{ section.settings.desktop_gap }}px;
    align-items: start;
  }

  /* ---- Card ---- */
  #{{ section_id }} .drpen-t-card {
    background-color: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    box-shadow: {{ section.settings.card_shadow }};
    text-align: {{ section.settings.card_text_align }};
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.card_text_align | replace: 'left', 'flex-start' | replace: 'center', 'center' | replace: 'right', 'flex-end' }};
  }

  /* ---- Icon / Stars ---- */
  #{{ section_id }} .drpen-t-card-icon {
    font-size: {{ section.settings.icon_size }}px;
    color: {{ section.settings.icon_color }};
    margin-bottom: {{ section.settings.icon_margin_bottom }}px;
    line-height: 1;
  }

  #{{ section_id }} .drpen-t-card-icon svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    fill: {{ section.settings.icon_color }};
  }

  /* ---- Quote ---- */
  #{{ section_id }} .drpen-t-quote {
    color: {{ section.settings.quote_color }};
    font-size: {{ section.settings.desktop_quote_size }}px;
    font-weight: {{ section.settings.quote_weight }};
    line-height: 1.6;
    margin: 0 0 {{ section.settings.quote_margin_bottom }}px 0;
    font-family: inherit;
    font-style: {{ section.settings.quote_italic }};
  }

  /* ---- Avatar ---- */
  #{{ section_id }} .drpen-t-avatar {
    width: {{ section.settings.avatar_size }}px;
    height: {{ section.settings.avatar_size }}px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: {{ section.settings.avatar_margin_bottom }}px;
    border: {{ section.settings.avatar_border_width }}px solid {{ section.settings.avatar_border_color }};
  }

  #{{ section_id }} .drpen-t-avatar-placeholder {
    width: {{ section.settings.avatar_size }}px;
    height: {{ section.settings.avatar_size }}px;
    border-radius: 50%;
    background: {{ section.settings.avatar_border_color }};
    margin-bottom: {{ section.settings.avatar_margin_bottom }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #aaa;
    font-size: {{ section.settings.avatar_size | divided_by: 2.5 | round }}px;
  }

  /* ---- Name ---- */
  #{{ section_id }} .drpen-t-name {
    color: {{ section.settings.name_color }};
    font-size: {{ section.settings.desktop_name_size }}px;
    font-weight: {{ section.settings.name_weight }};
    margin: 0 0 4px 0;
    font-family: inherit;
  }

  /* ---- Role ---- */
  #{{ section_id }} .drpen-t-role {
    color: {{ section.settings.role_color }};
    font-size: {{ section.settings.desktop_role_size }}px;
    font-weight: {{ section.settings.role_weight }};
    margin: 0;
    font-family: inherit;
  }

  /* ========== TABLET (≤1024px) ========== */
  @media screen and (max-width: 1024px) {
    #{{ section_id }} .drpen-t-grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
      gap: {{ section.settings.tablet_gap }}px;
    }
    #{{ section_id }} .drpen-t-heading {
      font-size: {{ section.settings.tablet_heading_size }}px;
    }
    #{{ section_id }} .drpen-t-subheading {
      font-size: {{ section.settings.tablet_subheading_size }}px;
    }
    #{{ section_id }} .drpen-t-quote {
      font-size: {{ section.settings.tablet_quote_size }}px;
    }
  }

  /* ========== MOBILE (≤749px) ========== */
  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: {{ section.settings.mobile_padding_lr }}px;
      padding-right: {{ section.settings.mobile_padding_lr }}px;
    }
    #{{ section_id }} .drpen-t-grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_gap }}px;
    }
    #{{ section_id }} .drpen-t-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      font-weight: {{ section.settings.mobile_heading_weight }};
    }
    #{{ section_id }} .drpen-t-subheading {
      font-size: {{ section.settings.mobile_subheading_size }}px;
    }
    #{{ section_id }} .drpen-t-quote {
      font-size: {{ section.settings.mobile_quote_size }}px;
    }
    #{{ section_id }} .drpen-t-name {
      font-size: {{ section.settings.mobile_name_size }}px;
    }
    #{{ section_id }} .drpen-t-role {
      font-size: {{ section.settings.mobile_role_size }}px;
    }
  }
</style>

<section id="{{ section_id }}" class="drpen-testimonials-wrapper">
  <div class="drpen-t-inner">

    {%- if section.settings.label != blank -%}
      <div class="drpen-t-label">
        {%- if section.settings.show_label_line -%}
          <span class="drpen-t-label-line"></span>
        {%- endif -%}
        <span class="drpen-t-label-text">{{ section.settings.label }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="drpen-t-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="drpen-t-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="drpen-t-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'testimonial' -%}
          <div class="drpen-t-card" {{ block.shopify_attributes }}>

            {%- if block.settings.show_icon and block.settings.icon_text != blank -%}
              <div class="drpen-t-card-icon">
                {%- if block.settings.icon_type == 'svg' -%}
                  {{ block.settings.icon_svg }}
                {%- else -%}
                  {{ block.settings.icon_text }}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.quote != blank -%}
              <p class="drpen-t-quote">{{ block.settings.quote }}</p>
            {%- endif -%}

            {%- if block.settings.avatar != blank -%}
              {{
                block.settings.avatar
                | image_url: width: 200
                | image_tag:
                  class: 'drpen-t-avatar',
                  loading: 'lazy',
                  alt: block.settings.name | default: 'Reviewer'
              }}
            {%- else -%}
              <div class="drpen-t-avatar-placeholder">👤</div>
            {%- endif -%}

            {%- if block.settings.name != blank -%}
              <p class="drpen-t-name">{{ block.settings.name }}</p>
            {%- endif -%}

            {%- if block.settings.role != blank -%}
              <p class="drpen-t-role">{{ block.settings.role }}</p>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
