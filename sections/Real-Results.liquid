{% comment %}
  ============================================================
  Section: Dr. Pen - Professional Microneedling Real Results Section
  Features:
    - Heading, subheading, images (6 grid)
    - Max-width, padding, margin, font-size, color, font-weight controls
    - Separate Desktop & Mobile customization
    - Icon support (SVG/emoji) per image card
    - Fully responsive
    - Font family inherited from global theme
  ============================================================
{% endcomment %}

{%- liquid
  assign section_id = 'drpen-real-results-' | append: section.id
-%}

<style>
  #{{ section_id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    padding-left: {{ section.settings.desktop_padding_lr }}px;
    padding-right: {{ section.settings.desktop_padding_lr }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    font-family: inherit;
  }

  #{{ section_id }} .drpen-inner {
    max-width: {{ section.settings.max_width }}px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ---- Heading ---- */
  #{{ section_id }} .drpen-heading {
    text-align: {{ section.settings.heading_align }};
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.desktop_heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.2;
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px 0;
    font-family: inherit;
  }

  /* ---- Subheading ---- */
  #{{ section_id }} .drpen-subheading {
    text-align: {{ section.settings.subheading_align }};
    color: {{ section.settings.subheading_color }};
    font-size: {{ section.settings.desktop_subheading_size }}px;
    font-weight: {{ section.settings.subheading_weight }};
    line-height: 1.6;
    margin: 0 auto {{ section.settings.subheading_margin_bottom }}px auto;
    max-width: {{ section.settings.subheading_max_width }}px;
    font-family: inherit;
  }

  /* ---- Image Grid ---- */
  #{{ section_id }} .drpen-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
    gap: {{ section.settings.desktop_gap }}px;
  }

  #{{ section_id }} .drpen-card {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.card_border_radius }}px;
    background: {{ section.settings.card_bg_color }};
    box-shadow: {{ section.settings.card_shadow }};
    aspect-ratio: {{ section.settings.card_aspect_ratio }};
  }

  #{{ section_id }} .drpen-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  {% if section.settings.card_hover_zoom %}
  #{{ section_id }} .drpen-card:hover img {
    transform: scale(1.05);
  }
  {% endif %}

  /* ---- Icon overlay on card ---- */
  #{{ section_id }} .drpen-card-icon {
    position: absolute;
    bottom: {{ section.settings.icon_bottom }}px;
    right: {{ section.settings.icon_right }}px;
    font-size: {{ section.settings.icon_size }}px;
    line-height: 1;
    background: {{ section.settings.icon_bg_color }};
    color: {{ section.settings.icon_color }};
    border-radius: {{ section.settings.icon_border_radius }}px;
    padding: {{ section.settings.icon_padding }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  #{{ section_id }} .drpen-card-icon svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    fill: currentColor;
  }

  /* ---- Placeholder (no image) ---- */
  #{{ section_id }} .drpen-placeholder {
    width: 100%;
    height: 100%;
    background: #e8edf2;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9aafbf;
    font-size: 14px;
    font-family: inherit;
  }

  /* ========== RESPONSIVE: Tablet ========== */
  @media screen and (max-width: 1024px) {
    #{{ section_id }} .drpen-grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns }}, 1fr);
      gap: {{ section.settings.tablet_gap }}px;
    }
    #{{ section_id }} .drpen-heading {
      font-size: {{ section.settings.tablet_heading_size }}px;
    }
    #{{ section_id }} .drpen-subheading {
      font-size: {{ section.settings.tablet_subheading_size }}px;
    }
  }

  /* ========== RESPONSIVE: Mobile ========== */
  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: {{ section.settings.mobile_padding_lr }}px;
      padding-right: {{ section.settings.mobile_padding_lr }}px;
    }

    #{{ section_id }} .drpen-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      font-weight: {{ section.settings.mobile_heading_weight }};
    }

    #{{ section_id }} .drpen-subheading {
      font-size: {{ section.settings.mobile_subheading_size }}px;
    }

    #{{ section_id }} .drpen-grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
      gap: {{ section.settings.mobile_gap }}px;
    }
  }
</style>

<section id="{{ section_id }}" class="drpen-hero-section">
  <div class="drpen-inner">

    {%- if section.settings.heading != blank -%}
      <h2 class="drpen-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="drpen-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="drpen-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image_card' -%}
          <div class="drpen-card" {{ block.shopify_attributes }}>

            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  alt: block.settings.image.alt | default: block.settings.icon_text,
                  widths: '400, 600, 800'
              }}
            {%- else -%}
              <div class="drpen-placeholder">
                <span>{{ 'image' | placeholder_svg_tag }}</span>
              </div>
            {%- endif -%}

            {%- if block.settings.show_icon and block.settings.icon_text != blank -%}
              <div class="drpen-card-icon">
                {%- if block.settings.icon_type == 'emoji' -%}
                  {{ block.settings.icon_text }}
                {%- elsif block.settings.icon_type == 'svg' -%}
                  {{ block.settings.icon_svg }}
                {%- else -%}
                  {{ block.settings.icon_text }}
                {%- endif -%}
              </div>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

