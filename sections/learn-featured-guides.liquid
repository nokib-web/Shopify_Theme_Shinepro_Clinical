<section
  id="learn-guides-{{ section.id }}"
  class="learn-guides-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.section_bg }};
  "
>

  <div class="learn-guides-wrapper">

    {% if section.settings.subheading != blank %}
      <div class="learn-guides-subheading">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="learn-guides-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="learn-guides-description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    <div class="learn-guides-grid">

      {% for block in section.blocks %}

        {% assign article = articles[block.settings.article] %}

        {% if article != blank %}

          <article
            class="learn-guide-card"
            {{ block.shopify_attributes }}
          >

            <a
              href="{{ article.url }}"
              class="learn-guide-image-link"
            >

              {% if article.image != blank %}

                {{
                  article.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    class: 'learn-guide-image',
                    alt: article.title
                }}

              {% endif %}

            </a>

            <div class="learn-guide-content">

              {% if section.settings.show_date %}
                <div class="learn-guide-meta">
                  {{ article.published_at | date: "%B %d, %Y" }}
                </div>
              {% endif %}

              <h3 class="learn-guide-title">
                <a href="{{ article.url }}">
                  {{ article.title }}
                </a>
              </h3>

              {% if section.settings.show_excerpt %}
                <div class="learn-guide-excerpt">
                  {{
                    article.excerpt_or_content
                    | strip_html
                    | truncatewords: section.settings.excerpt_words
                  }}
                </div>
              {% endif %}

              <a
                href="{{ article.url }}"
                class="learn-guide-button"
              >
                {{ section.settings.button_label }}
              </a>

            </div>

          </article>

        {% endif %}

      {% endfor %}

    </div>

  </div>

</section>

<style>

#learn-guides-{{ section.id }} .learn-guides-wrapper{
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
  padding-left: 20px;
  padding-right: 20px;
}

#learn-guides-{{ section.id }} .learn-guides-subheading{
  text-align: center;
  margin-bottom: 12px;

  color: {{ section.settings.subheading_color }};
  font-size: {{ section.settings.subheading_size }}px;
}

#learn-guides-{{ section.id }} .learn-guides-heading{
  text-align: center;
  margin: 0 0 16px;

  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  line-height: 1.2;
}

#learn-guides-{{ section.id }} .learn-guides-description{
  max-width: 760px;
  margin: 0 auto 50px;

  text-align: center;

  color: {{ section.settings.description_color }};
  font-size: {{ section.settings.description_size }}px;
  line-height: 1.7;
}

#learn-guides-{{ section.id }} .learn-guides-grid{
  display: grid;
  grid-template-columns: repeat({{ section.settings.desktop_columns }},1fr);
  gap: {{ section.settings.grid_gap }}px;
}

#learn-guides-{{ section.id }} .learn-guide-card{
  overflow: hidden;

  background: {{ section.settings.card_bg }};
  border-radius: {{ section.settings.card_radius }}px;

  border: 1px solid {{ section.settings.card_border }};

  transition: all .3s ease;
}

#learn-guides-{{ section.id }} .learn-guide-card:hover{
  transform: translateY(-5px);
}

#learn-guides-{{ section.id }} .learn-guide-image-link{
  display: block;
  overflow: hidden;
}

#learn-guides-{{ section.id }} .learn-guide-image{
  width: 100%;
  height: {{ section.settings.image_height }}px;

  object-fit: cover;
  display: block;

  transition: transform .5s ease;
}

#learn-guides-{{ section.id }} .learn-guide-card:hover .learn-guide-image{
  transform: scale(1.05);
}

#learn-guides-{{ section.id }} .learn-guide-content{
  padding:
    {{ section.settings.content_padding_top }}px
    {{ section.settings.content_padding_side }}px
    {{ section.settings.content_padding_bottom }}px;
}

#learn-guides-{{ section.id }} .learn-guide-meta{
  margin-bottom: 14px;

  color: {{ section.settings.meta_color }};
  font-size: {{ section.settings.meta_size }}px;
}

#learn-guides-{{ section.id }} .learn-guide-title{
  margin: 0 0 16px;

  font-size: {{ section.settings.title_size }}px;
  line-height: 1.3;
}

#learn-guides-{{ section.id }} .learn-guide-title a{
  text-decoration: none;
  color: {{ section.settings.title_color }};
}

#learn-guides-{{ section.id }} .learn-guide-excerpt{
  margin-bottom: 24px;

  color: {{ section.settings.text_color }};
  font-size: {{ section.settings.text_size }}px;
  line-height: 1.7;
}

#learn-guides-{{ section.id }} .learn-guide-button{
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 48px;

  padding: 12px 24px;

  text-decoration: none;

  background: {{ section.settings.button_bg }};
  color: {{ section.settings.button_text }};

  border-radius: {{ section.settings.button_radius }}px;

  transition: all .3s ease;
}

#learn-guides-{{ section.id }} .learn-guide-button:hover{
  opacity: .9;
}

@media screen and (max-width: 991px){

  #learn-guides-{{ section.id }} .learn-guides-grid{
    grid-template-columns: repeat({{ section.settings.tablet_columns }},1fr);
  }

  #learn-guides-{{ section.id }} .learn-guides-heading{
    font-size: {{ section.settings.heading_size_tablet }}px;
  }

}

@media screen and (max-width: 767px){

  #learn-guides-{{ section.id }} .learn-guides-grid{
    display: flex;
    overflow-x: auto;

    gap: 16px;

    scroll-snap-type: x mandatory;
  }

  #learn-guides-{{ section.id }} .learn-guides-grid::-webkit-scrollbar{
    display: none;
  }

  #learn-guides-{{ section.id }} .learn-guide-card{
    min-width: {{ section.settings.mobile_card_width }}px;
    scroll-snap-align: start;
  }

  #learn-guides-{{ section.id }} .learn-guides-heading{
    font-size: {{ section.settings.heading_size_mobile }}px;
  }

}

</style>

{% schema %}
{
