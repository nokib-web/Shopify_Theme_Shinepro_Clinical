<section
  id="about-brand-story-{{ section.id }}"
  class="about-brand-story-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.section_bg }};
  "
>

  <div class="about-brand-story-wrapper">

    <div class="about-brand-story-grid">

      <div class="about-brand-story-image-column">

        {% if section.settings.image != blank %}

          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              class: 'about-brand-story-image',
              alt: section.settings.heading
          }}

        {% endif %}

      </div>

      <div class="about-brand-story-content-column">

        {% if section.settings.badge != blank %}
          <div class="about-brand-story-badge">
            {{ section.settings.badge }}
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="about-brand-story-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="about-brand-story-description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}

        <div class="about-brand-story-features">

          {% for block in section.blocks %}

            <div
              class="about-brand-story-feature"
              {{ block.shopify_attributes }}
            >

              <div class="about-brand-story-feature-icon">
                ✓
              </div>

              <div class="about-brand-story-feature-text">
                {{ block.settings.text }}
              </div>

            </div>

          {% endfor %}

        </div>

        {% if section.settings.button_label != blank %}

          <a
            href="{{ section.settings.button_link }}"
            class="about-brand-story-button"
          >
            {{ section.settings.button_label }}
          </a>

        {% endif %}

      </div>

    </div>

  </div>

</section>

<style>

#about-brand-story-{{ section.id }} .about-brand-story-wrapper{
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
  padding-left: 20px;
  padding-right: 20px;
}

#about-brand-story-{{ section.id }} .about-brand-story-grid{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: {{ section.settings.grid_gap }}px;
  align-items: center;
}

#about-brand-story-{{ section.id }} .about-brand-story-image{
  width: 100%;
  display: block;

  border-radius: {{ section.settings.image_radius }}px;
}

#about-brand-story-{{ section.id }} .about-brand-story-badge{
  display: inline-flex;

  margin-bottom: 18px;

  padding: 10px 18px;

  border-radius: 100px;

  background: {{ section.settings.badge_bg }};
  color: {{ section.settings.badge_color }};

  font-size: {{ section.settings.badge_size }}px;
  font-weight: 600;
}

#about-brand-story-{{ section.id }} .about-brand-story-heading{
  margin: 0 0 24px;

  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  line-height: 1.1;
}

#about-brand-story-{{ section.id }} .about-brand-story-description{
  margin-bottom: 30px;

  color: {{ section.settings.description_color }};
  font-size: {{ section.settings.description_size }}px;
  line-height: 1.8;
}

#about-brand-story-{{ section.id }} .about-brand-story-features{
  display: flex;
  flex-direction: column;
  gap: 18px;

  margin-bottom: 36px;
}

#about-brand-story-{{ section.id }} .about-brand-story-feature{
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

#about-brand-story-{{ section.id }} .about-brand-story-feature-icon{
  width: 28px;
  height: 28px;

  border-radius: 50%;

  background: {{ section.settings.icon_bg }};
  color: {{ section.settings.icon_color }};

  display: flex;
  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  font-size: 14px;
  font-weight: 700;
}

#about-brand-story-{{ section.id }} .about-brand-story-feature-text{
  color: {{ section.settings.feature_color }};
  font-size: {{ section.settings.feature_size }}px;
  line-height: 1.7;
}

#about-brand-story-{{ section.id }} .about-brand-story-button{
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 54px;

  padding: 14px 30px;

  border-radius: {{ section.settings.button_radius }}px;

  background: {{ section.settings.button_bg }};
  color: {{ section.settings.button_text }};

  text-decoration: none;

  transition: all .3s ease;
}

#about-brand-story-{{ section.id }} .about-brand-story-button:hover{
  opacity: .9;
}

@media screen and (max-width: 991px){

  #about-brand-story-{{ section.id }} .about-brand-story-grid{
    gap: 40px;
  }

  #about-brand-story-{{ section.id }} .about-brand-story-heading{
    font-size: {{ section.settings.heading_size_tablet }}px;
  }

}

@media screen and (max-width: 767px){

  #about-brand-story-{{ section.id }} .about-brand-story-grid{
    grid-template-columns: 1fr;
  }

  #about-brand-story-{{ section.id }} .about-brand-story-heading{
    font-size: {{ section.settings.heading_size_mobile }}px;
  }

  #about-brand-story-{{ section.id }} .about-brand-story-description{
    font-size: {{ section.settings.description_size_mobile }}px;
  }

}

</style>

{% schema %}
{
  "name": "About Brand Story",

  "settings": [

    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },

    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Our Story"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Professional Microneedling Education & Innovation"
    },

    {
      "type": "richtext",
