    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Section Bottom Padding",
      "default": 40
    },

    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Section Top Margin",
      "default": 0
    },

    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Section Bottom Margin",
      "default": 0
    }

  ],

  "presets": [
    {
      "name": "Learn Hero"
    }
  ]
}
{% endschema %}